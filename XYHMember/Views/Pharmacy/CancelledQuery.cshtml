@{
    ViewBag.Title = "已退药查询";
}

@using XYHMember.Context;
@model List<DispensedRecord>

@{
    var name = Request["name"];
    var bdatepicker = Request["bdatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edatepicker = Request["edatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")
    <style>
        #dataTable {
            width: 80% !important;
            min-width: 600px !important;
            table-layout: auto !important;
        }
        #dataTable th,
        #dataTable td {
            padding: 2px 5px !important;
        }
        #dataTable th:last-child,
        #dataTable td:last-child {
            padding-right: 40px !important;
        }
        .table-wrapper {
            overflow: auto !important;
            max-width: calc(100vw - 40px) !important;
        }
        .table-wrapper > table {
            display: table !important;
        }
    </style>
</head>

<body>
    <div>

        <div class="container">
            <div style="margin-left:300px;">
                <form action="@Url.Action("GetCancelledQuery", "Pharmacy")" method="post">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;">
                        <label style="margin:0 5px 0 10px;">退药时间</label>
                        <input type="text" name="bdatepicker" id="bdatepicker"
                               value="@bdatepicker" placeholder="开始日期" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" name="edatepicker" id="edatepicker"
                               value="@edatepicker" placeholder="结束日期" style="height:30px;">
                        <span style="margin-left:40px;display:inline-flex;align-items:center;gap:6px;">
                            <input type="text" class="am-form-field" name="name" value="@name" placeholder="姓名" style="width:140px;">
                            <span class="am-input-group-btn">
                                <button class="am-btn am-btn-default" type="submit">查询</button>
                            </span>
                        </span>
                    </div>
                </form>
            </div>
        </div>
        <div class="am-g">
            <div class="am-u-sm-12">

                <div class="table-wrapper" style="overflow:auto;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th class="table-chck"><input type="checkbox"></th>
                            <th>序号</th>
                            <th>处方ID</th>
                            <th>病人姓名</th>
                            <th>处方日期</th>
                            <th>发药人工号</th>
                            <th>发药人姓名</th>
                            <th>发药日期</th>
                            <th>发票状态</th>
                            <th>发药状态</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Count > 0)
                    {
                        <tbody>
                            @{
                                int rowNum = 0;
                            }
                            @foreach (var result in Model)
                            {
                                rowNum++;
                                <tr>
                                    <td><input type="checkbox" data-pid="@result.处方ID" data-billdate="@result.处方日期" data-outcfcode="@result.outcfcode_original" data-dispensedate="@result.发药日期"></td>
                                    <td>@rowNum</td>
                                    <td>@result.处方ID</td>
                                    <td>@result.病人姓名</td>
                                    <td>@result.处方日期</td>
                                    <td>@result.发药人工号</td>
                                    <td>@result.发药人姓名</td>
                                    <td>@(result.发药时间 != null ? result.发药时间.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                    <td@(result.发票状态 == "已退费" ? " style=\"background-color:#ff6666;color:#fff;font-weight:bold;\"" : "")>@result.发票状态</td>
                                    <td>@(result.发药状态 == 3 ? "已发药" : result.发药状态 == 9 ? "已退药" : (result.发药状态.HasValue ? result.发药状态.Value.ToString() : ""))</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
                </div>

                @if (Model != null && Model.Count > 1)
                {
                    <div id="paginationContainer"></div>
                }

            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@bdatepicker"
        });
        flatpickr("#edatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@edatepicker"
        });

        initTablePagination('dataTable');

        // 全选/取消全选
        var headerChk = document.querySelector('#dataTable thead input[type=checkbox]');
        if (headerChk) {
            headerChk.addEventListener('change', function () {
                var checked = this.checked;
                document.querySelectorAll('#dataTable tbody input[type=checkbox]').forEach(function (cb) {
                    cb.checked = checked;
                });
            });
        }
    </script>

</body>
</html>
