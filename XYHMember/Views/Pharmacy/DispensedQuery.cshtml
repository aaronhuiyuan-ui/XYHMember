@{
    ViewBag.Title = "已发药查询";
}

@using XYHMember.Context;
@model List<DispensedRecord>

@{
    var name = Request["name"];
    var bdatepicker = Request["bdatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edatepicker = Request["edatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")
    <style>
        #dataTable {
            width: 80% !important;
            min-width: 600px !important;
            table-layout: auto !important;
        }
        #dataTable th,
        #dataTable td {
            padding: 2px 5px !important;
        }
        #dataTable th:last-child,
        #dataTable td:last-child {
            padding-right: 40px !important;
        }
        .table-wrapper {
            overflow: auto !important;
            max-width: calc(100vw - 40px) !important;
        }
        .table-wrapper > table {
            display: table !important;
        }
        .row-refund { background-color: #ffcccc !important; color: #cc0000 !important; font-weight: bold !important; }

        /* 处方结果弹窗 - 参照确认发药界面 */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
            z-index: 10000;
            overflow: auto;
            padding: 30px;
        }
        .modal-box {
            max-width: 900px;
            margin: 20px auto;
            background: #fff;
            border-radius: 6px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        .modal-header {
            padding: 14px 20px;
            border-bottom: 1px solid #eee;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-header .close-btn {
            color: #999;
            text-decoration: none;
            font-size: 22px;
            cursor: pointer;
        }
        .modal-header .close-btn:hover { color: #333; }
        .modal-body {
            padding: 20px;
            max-height: 560px;
            overflow: auto;
        }
        .modal-footer {
            padding: 12px 20px;
            border-top: 1px solid #eee;
            text-align: right;
        }
        /* 信息栏 */
        .info-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 18px;
            padding: 12px 16px;
            background: #f5f8fc;
            border-radius: 4px;
            margin-bottom: 14px;
            font-size: 13px;
        }
        .info-bar span { white-space: nowrap; }
        .info-bar label { color: #888; margin-right: 3px; }
        .info-bar .val { font-weight: 600; color: #333; }
        /* 区块标题 */
        .section-title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            padding-left: 10px;
            border-left: 3px solid #4d7496;
        }
        /* 字段网格 */
        .field-grid {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 8px 16px;
            margin-bottom: 14px;
            padding: 12px;
            background: #fafbfc;
            border-radius: 4px;
            border: 1px solid #eee;
        }
        .field-grid .fg-item {
            display: flex;
            align-items: center;
        }
        .field-grid .fg-item label {
            width: 90px;
            font-size: 13px;
            color: #555;
            flex-shrink: 0;
        }
        .field-grid .fg-item span {
            font-size: 13px;
            color: #333;
        }
        .field-grid .fg-full { grid-column: 1 / -1; }
        .field-grid .fg-double { grid-column: span 2; }
        /* 明细表格 */
        .detail-table-wrap {
            margin-bottom: 14px;
            border: 1px solid #e8e8e8;
            border-radius: 4px;
            overflow: auto;
            max-height: 220px;
        }
        .detail-table-wrap table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        .detail-table-wrap th {
            background: #f0f2f5;
            padding: 6px 10px;
            text-align: left;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
            position: sticky;
            top: 0;
        }
        .detail-table-wrap td {
            padding: 5px 10px;
            border-bottom: 1px solid #f0f0f0;
            white-space: nowrap;
        }
        .detail-table-wrap tbody tr:hover { background: #f5f8fc; }
    </style>
</head>

<body>
    <div>

        <div class="container">
            <div style="margin-left:300px;">
                <form action="@Url.Action("GetDispensedQuery", "Pharmacy")" method="post">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;">
                        <label style="margin:0 5px 0 10px;">发药时间</label>
                        <input type="text" name="bdatepicker" id="bdatepicker"
                               value="@bdatepicker" placeholder="开始日期" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" name="edatepicker" id="edatepicker"
                               value="@edatepicker" placeholder="结束日期" style="height:30px;">
                        <span style="margin-left:40px;display:inline-flex;align-items:center;gap:6px;">
                            <input type="text" class="am-form-field" name="name" value="@name" placeholder="姓名" style="width:140px;">
                            <span class="am-input-group-btn">
                                <button class="am-btn am-btn-default" type="submit">查询</button>
                                <button class="am-btn am-btn-primary" type="button" id="detailBtn" style="margin-left:15px;background:#4d7496!important;border-color:#4d7496!important;color:#fff!important;">处方结果</button>
                                <button class="am-btn am-btn-primary" type="button" id="cancelBtn" style="margin-left:15px;background:#d9534f!important;border-color:#d9534f!important;color:#fff!important;">退药</button>
                            </span>
                        </span>
                    </div>
                </form>
            </div>
        </div>
        <div class="am-g">
            <div class="am-u-sm-12">

                <div class="table-wrapper" style="overflow:auto;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th class="table-chck"><input type="checkbox"></th>
                            <th>序号</th>
                            <th>处方ID</th>
                            <th>病人姓名</th>
                            <th>处方日期</th>
                            <th>发药人工号</th>
                            <th>发药人姓名</th>
                            <th>发药日期</th>
                            <th>收货人</th>
                            <th>收货电话</th>
                            <th>收货地址</th>
                            <th>发票状态</th>
                            <th>发药状态</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Count > 0)
                    {
                        <tbody>
                            @{
                                int rowNum = 0;
                            }
                            @foreach (var result in Model)
                            {
                                rowNum++;
                                <tr data-invoice-status="@result.发票状态">
                                    <td><input type="checkbox" data-pid="@result.处方ID" data-billdate="@result.处方日期" data-outcfcode="@result.outcfcode_original" data-dispensedate="@result.发药日期"></td>
                                    <td>@rowNum</td>
                                    <td>@result.处方ID</td>
                                    <td>@result.病人姓名</td>
                                    <td>@result.处方日期</td>
                                    <td>@result.发药人工号</td>
                                    <td>@result.发药人姓名</td>
                                    <td>@(result.发药时间 != null ? result.发药时间.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                                    <td>@result.收货人</td>
                                    <td>@result.收货电话</td>
                                    <td>@result.收货地址</td>
                                    <td>@result.发票状态</td>
                                    <td>@(result.发药状态 == 3 ? "已发药" : result.发药状态 == 9 ? "已退药" : (result.发药状态.HasValue ? result.发药状态.Value.ToString() : ""))</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
                </div>

                @if (Model != null && Model.Count > 1)
                {
                    <div id="paginationContainer"></div>
                }

            </div>
        </div>
    </div>

    <!-- 处方结果弹窗 -->
    <div class="modal-overlay" id="detailModal" style="display:none;">
        <div class="modal-box">
            <div class="modal-header">
                <span>处方结果信息</span>
                <a class="close-btn" href="javascript:void(0)" onclick="closeDetailModal()">&times;</a>
            </div>
            <div class="modal-body" id="detailModalBody" style="padding:0;">
                <!-- 动态填充 -->
            </div>
            <div class="modal-footer">
                <button class="am-btn am-btn-default" onclick="closeDetailModal()">关闭</button>
            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    <script src="~/Scripts/customDialog.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@bdatepicker"
        });
        flatpickr("#edatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@edatepicker"
        });

        initTablePagination('dataTable');

        // 全选/取消全选
        var headerChk = document.querySelector('#dataTable thead input[type=checkbox]');
        if (headerChk) {
            headerChk.addEventListener('change', function () {
                var checked = this.checked;
                document.querySelectorAll('#dataTable tbody input[type=checkbox]').forEach(function (cb) {
                    cb.checked = checked;
                });
            });
        }

        // 处方结果 & 退药按钮点击事件（始终注册，点击时判断是否有数据）
        var cancelBtn = document.getElementById('cancelBtn');
        var detailBtn = document.getElementById('detailBtn');

        detailBtn.addEventListener('click', function () {
                var checkedBoxes = document.querySelectorAll('#dataTable tbody input[type=checkbox]:checked');
                if (checkedBoxes.length === 0) {
                    customDialog.alert('请选择要查看结果的处方');
                    return;
                }
                if (checkedBoxes.length > 1) {
                    customDialog.alert('一次只能查看一个处方结果');
                    return;
                }

                var pid = checkedBoxes[0].getAttribute('data-pid');
                if (!pid) {
                    customDialog.alert('未获取到处方ID');
                    return;
                }

                var billdate = checkedBoxes[0].getAttribute('data-billdate') || '';
                var outcfcode = checkedBoxes[0].getAttribute('data-outcfcode') || '';

                detailBtn.disabled = true;
                detailBtn.innerText = '查询中...';

                fetch('@Url.Action("GetPrescriptionDetail", "Pharmacy")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prescriptionId: parseInt(pid), billdate: billdate, outcfcode: outcfcode })
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    detailBtn.disabled = false;
                    detailBtn.innerText = '处方结果';
                    if (data.success) {
                        renderDetailData(data.data);
                        document.getElementById('detailModal').style.display = 'block';
                    } else {
                        customDialog.error('查询失败：' + data.msg + '\n\n原始响应:\n' + (data.rawResponse || data.apiResponse || '无'));
                    }
                })
                .catch(function (err) {
                    detailBtn.disabled = false;
                    detailBtn.innerText = '处方结果';
                    customDialog.error('查询失败：' + err);
                });
            });

            cancelBtn.addEventListener('click', function () {
                var checkedBoxes = document.querySelectorAll('#dataTable tbody input[type=checkbox]:checked');
                if (checkedBoxes.length === 0) {
                    customDialog.alert('请选择要退药的处方');
                    return;
                }

                customDialog.confirm('确认要退药吗？', '退药确认', function () {
                    var pids = [];
                    var outcfcodes = [];
                    var billdates = [];
                    checkedBoxes.forEach(function (cb) {
                        var pid = cb.getAttribute('data-pid');
                        if (pid) {
                            pids.push(pid);
                            outcfcodes.push(cb.getAttribute('data-outcfcode') || '');
                            billdates.push(cb.getAttribute('data-dispensedate') || '');
                        }
                    });

                    if (pids.length === 0) {
                        customDialog.alert('未获取到处方ID');
                        return;
                    }

                    // 逐个退药
                    (function doCancel(idx) {
                        if (idx >= pids.length) {
                            customDialog.success('退药完成', '成功', function () {
                                location.reload();
                            });
                            return;
                        }

                        fetch('@Url.Action("CancelDispensedPrescription", "Pharmacy")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ prescriptionId: parseInt(pids[idx]), outcfcode: outcfcodes[idx], billdate: billdates[idx] })
                        })
                        .then(function (r) { return r.json(); })
                        .then(function (data) {
                            if (data.success) {
                                doCancel(idx + 1);
                            } else {
                                customDialog.error('退药失败(' + pids[idx] + '): ' + data.msg + '\n\n完整返回:\n' + (data.apiResponse || '无'));
                            }
                        })
                        .catch(function (err) {
                            customDialog.error('退药失败(' + pids[idx] + '): ' + err);
                        });
                    })(0);
                });
            });

            // 检测已退费发票状态
            setTimeout(function() {
                var refundRows = document.querySelectorAll('#dataTable tbody tr[data-invoice-status="已退费"]');
                if (refundRows.length > 0) {
                    customDialog.warning('有已退费药品已发药，请立即退药', '警告', function() {
                        refundRows.forEach(function(tr) {
                            tr.classList.add('row-refund');
                        });
                    });
                }
            }, 200);

        // HTML转义
        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        // 中文字段映射
        var fieldLabels = {
            'patient': '患者姓名',
            'age': '年龄',
            'sex': '性别',
            'billdate': '业务日期',
            'outcfcode': '客户处方编号',
            'outcfsn': '客户处方序号',
            'tpyq': '调配要求',
            'zgyq': '制膏要求',
            'cfdate': '处方日期',
            'ispregnancy': '是否妊娠',
            'cftype': '处方类型',
            'agentnum': '剂数',
            'remark': '备注',
            'opinion': '审批意见',
            'customername': '客户名称',
            'orgname': '机构名称',
            'dosages': '单剂总用量',
            'jyyq': '煎药要求',
            'jyplan': '煎药方案',
            'department': '病区科室',
            'pictureip': '图片地址',
            'logisticscost': '物流费',
            'processcost': '加工费',
            'cfzt': '处方状态',
            'reviewstaff': '审核员',
            'cfreviewtime': '审核时间',
            'mixstaff': '调配员',
            'mixrequesttime': '调配索取时间',
            'mixsuretime': '调配确认时间',
            'mixreviewstaff': '调配复核员',
            'mixreviewtime': '调配复核确认时间',
            'soakstaff': '浸泡员',
            'soakrequesttime': '浸泡索取时间',
            'soaksuretime': '浸泡确认时间',
            'jystaff': '煎药员',
            'jyrequesttime': '煎药索取时间',
            'jysuretime': '煎药确认时间',
            'zgstaff': '制膏员',
            'zgrequesttime': '制膏索取时间',
            'zgsuretime': '制膏确认时间',
            'inpackagestaff': '内包装员',
            'inpackagetime': '内包装确认时间',
            'outpackagestaff': '外包装员',
            'outpackagetime': '外包装完成时间',
            'logisticscompany': '物流公司',
            'expressnumber': '快递单号',
            'pk': '处方汇总主键'
        };

        // 明细列中文映射
        var detailLabels = {
            'goodsid': '饮片主键',
            'goodsname': '饮片名称',
            'dosage': '饮片用量',
            'tpyq': '调配要求',
            'price': '价格'
        };

        // 渲染处方结果
        function renderDetailData(data) {
            var body = document.getElementById('detailModalBody');
            if (!data || typeof data !== 'object') {
                body.innerHTML = '<div style="padding:40px;text-align:center;color:#e4393c;font-size:15px;">无处方数据</div>';
                return;
            }

            var html = '';

            // ---- 信息栏（关键信息） ----
            var infoKeys = ['patient', 'age', 'sex', 'billdate', 'outcfcode', 'outcfsn'];
            html += '<div class="info-bar">';
            for (var i = 0; i < infoKeys.length; i++) {
                var k = infoKeys[i];
                if (data[k] !== undefined && data[k] !== null && data[k] !== '') {
                    html += '<span><label>' + (fieldLabels[k] || k) + '：</label><span class="val">' + data[k] + '</span></span>';
                }
            }
            html += '</div>';

            // ---- 基本信息网格 ----
            var basicKeys = ['cfdate', 'cftype', 'jyyq', 'jyplan', 'agentnum', 'ispregnancy', 'tpyq', 'zgyq', 'dosages', 'cfzt', 'department', 'customername', 'orgname', 'remark', 'opinion'];
            html += '<div class="section-title">处方信息</div>';
            html += '<div class="field-grid">';
            for (var j = 0; j < basicKeys.length; j++) {
                var k2 = basicKeys[j];
                if (data[k2] !== undefined && data[k2] !== null && data[k2] !== '') {
                    var cls = (k2 === 'remark' || k2 === 'opinion' || k2 === 'customername' || k2 === 'orgname' || k2 === 'department') ? ' fg-full' : '';
                    html += '<div class="fg-item' + cls + '"><label>' + (fieldLabels[k2] || k2) + '：</label><span>' + data[k2] + '</span></div>';
                }
            }
            html += '</div>';

            // ---- 处方图片 ----
            if (data.pictureip && data.pictureip !== '') {
                html += '<div class="section-title">处方图片</div>';
                html += '<div style="text-align:center;margin-bottom:14px;padding:12px;background:#fafbfc;border-radius:4px;border:1px solid #eee;">';
                html += '<img src="' + data.pictureip + '" style="max-width:100%;max-height:400px;border-radius:4px;cursor:pointer;" onclick="window.open(this.src)" alt="处方图片" onerror="this.style.display=\'none\';this.nextElementSibling.style.display=\'block\'">';
                html += '<div style="display:none;padding:20px;color:#999;font-size:13px;">图片加载失败<br><a href="' + data.pictureip + '" target="_blank" style="color:#4d7496;word-break:break-all;">' + data.pictureip + '</a></div>';
                html += '</div>';
            }

            // ---- 费用信息 ----
            var costKeys = ['logisticscost', 'processcost'];
            var hasCost = false;
            for (var c = 0; c < costKeys.length; c++) {
                if (data[costKeys[c]] !== undefined && data[costKeys[c]] !== null && data[costKeys[c]] !== '') hasCost = true;
            }
            if (hasCost) {
                html += '<div class="section-title">费用信息</div>';
                html += '<div class="field-grid">';
                for (var c2 = 0; c2 < costKeys.length; c2++) {
                    var kc = costKeys[c2];
                    if (data[kc] !== undefined && data[kc] !== null && data[kc] !== '') {
                        html += '<div class="fg-item"><label>' + (fieldLabels[kc] || kc) + '：</label><span>' + data[kc] + '</span></div>';
                    }
                }
                html += '</div>';
            }

            // ---- 物流信息 ----
            html += '<div class="section-title">物流信息</div>';
            html += '<div class="field-grid">';
            var logisticsKeys = ['logisticscompany', 'expressnumber'];
            for (var l = 0; l < logisticsKeys.length; l++) {
                var kl = logisticsKeys[l];
                var val = (data[kl] !== undefined && data[kl] !== null) ? data[kl] : '';
                html += '<div class="fg-item"><label>' + (fieldLabels[kl] || kl) + '：</label><span>' + val + '</span></div>';
            }
            html += '</div>';

            // ---- 审核/调配/煎药等流程信息 ----
            var processGroups = [
                { title: '审核信息', keys: ['reviewstaff', 'cfreviewtime'] },
                { title: '调配信息', keys: ['mixstaff', 'mixrequesttime', 'mixsuretime', 'mixreviewstaff', 'mixreviewtime'] },
                { title: '浸泡信息', keys: ['soakstaff', 'soakrequesttime', 'soaksuretime'] },
                { title: '煎药信息', keys: ['jystaff', 'jyrequesttime', 'jysuretime'] },
                { title: '制膏信息', keys: ['zgstaff', 'zgrequesttime', 'zgsuretime'] },
                { title: '包装信息', keys: ['inpackagestaff', 'inpackagetime', 'outpackagestaff', 'outpackagetime'] }
            ];
            for (var g = 0; g < processGroups.length; g++) {
                var group = processGroups[g];
                var hasAny = false;
                for (var gi = 0; gi < group.keys.length; gi++) {
                    if (data[group.keys[gi]] !== undefined && data[group.keys[gi]] !== null && data[group.keys[gi]] !== '') { hasAny = true; break; }
                }
                if (hasAny) {
                    html += '<div class="section-title">' + group.title + '</div>';
                    html += '<div class="field-grid">';
                    for (var gi2 = 0; gi2 < group.keys.length; gi2++) {
                        var kg = group.keys[gi2];
                        if (data[kg] !== undefined && data[kg] !== null && data[kg] !== '') {
                            html += '<div class="fg-item"><label>' + (fieldLabels[kg] || kg) + '：</label><span>' + data[kg] + '</span></div>';
                        }
                    }
                    html += '</div>';
                }
            }

            // ---- 处方明细 ----
            var mxList = data.sellKpMxVos || null;
            if (mxList && mxList.length > 0) {
                html += '<div class="section-title">饮片明细</div>';
                html += '<div class="detail-table-wrap">';
                html += '<table><thead><tr>';
                // 明细表头：饮片名称、饮片用量、调配要求、价格
                var detailCols = ['goodsname', 'dosage', 'tpyq', 'price'];
                for (var di = 0; di < detailCols.length; di++) {
                    html += '<th>' + (detailLabels[detailCols[di]] || detailCols[di]) + '</th>';
                }
                html += '</tr></thead><tbody>';
                for (var ri = 0; ri < mxList.length; ri++) {
                    html += '<tr>';
                    for (var dj = 0; dj < detailCols.length; dj++) {
                        var v = mxList[ri][detailCols[dj]];
                        html += '<td>' + (v !== undefined && v !== null ? v : '') + '</td>';
                    }
                    html += '</tr>';
                }
                html += '</tbody></table></div>';
            }

            // ---- 其他未知字段 ----
            var extraKeys = [];
            for (var prop in data) {
                if (fieldLabels[prop] !== undefined) continue;
                if (prop === 'sellKpMxVos') continue;
                if (typeof data[prop] === 'object' && data[prop] !== null) continue;
                if (data[prop] === undefined || data[prop] === null || data[prop] === '') continue;
                extraKeys.push(prop);
            }
            if (extraKeys.length > 0) {
                html += '<div class="section-title">其他信息</div>';
                html += '<div class="field-grid">';
                for (var ei = 0; ei < extraKeys.length; ei++) {
                    html += '<div class="fg-item"><label>' + extraKeys[ei] + '：</label><span>' + data[extraKeys[ei]] + '</span></div>';
                }
                html += '</div>';
            }

            if (html === '') {
                html = '<div style="padding:40px;text-align:center;color:#e4393c;font-size:15px;">无处方数据</div>';
            }

            body.innerHTML = '<div style="padding:20px;">' + html + '</div>';
        }

        function closeDetailModal() {
            document.getElementById('detailModal').style.display = 'none';
        }

        // 点击空白处关闭弹窗
        document.getElementById('detailModal').addEventListener('click', function (e) {
            if (e.target === this) closeDetailModal();
        });
    </script>

</body>
</html>
