@{
    ViewBag.Title = "门诊待发药查询";
}

@using XYHMember.Context;
@model List<PharmacyDispensing>

@{
    var name = Request["name"];
    var bdatepicker = Request["bdatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edatepicker = Request["edatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")
    <style>
        #dataTable {
            width: 1800px !important;
            min-width: 1800px !important;
            table-layout: auto !important;
        }
        #dataTable th,
        #dataTable td {
            padding: 2px 5px !important;
        }
        #dataTable th:last-child,
        #dataTable td:last-child {
            padding-right: 40px !important;
        }
        .table-wrapper {
            overflow: auto !important;
            max-width: calc(100vw - 40px) !important;
        }
        .table-wrapper > table {
            display: table !important;
        }
    </style>
</head>

<body>
    <div>

        <div class="container">
            <div style="margin-left:300px;">
                <form controller="Pharmacy" action="GetDispensingQuery" method="get">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;">
                        <label style="margin:0 5px 0 10px;">开方日期</label>
                        <input type="text" name="bdatepicker" id="bdatepicker"
                               value="@bdatepicker" placeholder="开始日期" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" name="edatepicker" id="edatepicker"
                               value="@edatepicker" placeholder="结束日期" style="height:30px;">
                        <input type="text" class="am-form-field" name="name" value="@name" placeholder="姓名" style="width:180px;margin-left:10px;">
                        <span class="am-input-group-btn">
                            <button class="am-btn am-btn-default" type="submit">查询</button>
                            <button class="am-btn am-btn-primary" type="button" id="dispenseBtn" style="margin-left:15px;background:#51a351!important;border-color:#51a351!important;color:#fff!important;" disabled>发药</button>
                        </span>
                    </div>
                </form>
            </div>
        </div>
        <div class="am-g">
            <div class="am-u-sm-12">

                <div class="table-wrapper" style="overflow:auto;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th class="table-chck"><input type="checkbox"></th>
                            <th>序号</th>
                            <th>结帐ID</th>
                            <th>处方ID</th>
                            <th>门诊号</th>
                            <th>姓名</th>
                            <th>开方日期</th>
                            <th>开方时间</th>
                            <th>医生工号</th>
                            <th>医生姓名</th>
                            <th>草药帖数</th>
                            <th>总金额</th>
                            <th>发票状态</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Count > 0)
                    {
                        <tbody>
                            @{
                                int rowNum = 0;
                            }
                            @foreach (var result in Model)
                            {
                                rowNum++;
                                <tr>
                                    <td><input type="checkbox"></td>
                                    <td>@rowNum</td>
                                    <td>@result.结帐ID</td>
                                    <td>@result.处方ID</td>
                                    <td>@result.门诊号</td>
                                    <td>@result.姓名</td>
                                    <td>@result.开方日期</td>
                                    <td>@result.开方时间</td>
                                    <td>@result.医生工号</td>
                                    <td>@result.医生姓名</td>
                                    <td>@result.草药帖数</td>
                                    <td>@result.总金额</td>
                                    <td>@result.发票状态</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
                </div>

                @if (Model != null && Model.Count > 1)
                {
                    <div id="paginationContainer"></div>
                }

            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@bdatepicker"
        });
        flatpickr("#edatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@edatepicker"
        });

        initTablePagination('dataTable');

        // 全选/取消全选
        document.querySelector('#dataTable thead input[type=checkbox]').addEventListener('change', function () {
            var checked = this.checked;
            document.querySelectorAll('#dataTable tbody input[type=checkbox]').forEach(function (cb) {
                cb.checked = checked;
            });
        });

        // 有数据时才启用发药按钮
        @if (Model != null && Model.Count > 0)
        {
            <text>
            var dispenseBtn = document.getElementById('dispenseBtn');
            dispenseBtn.disabled = false;

            dispenseBtn.addEventListener('click', function () {
                var checkedBoxes = document.querySelectorAll('#dataTable tbody input[type=checkbox]:checked');
                if (checkedBoxes.length === 0) {
                    alert('请选择要发药的处方');
                    return;
                }

                var prescriptionIds = [];
                var checkoutIds = [];
                checkedBoxes.forEach(function (cb) {
                    var row = cb.closest('tr');
                    var prescriptionId = row.children[2].innerText.trim(); // 处方ID
                    var checkoutId = row.children[1].innerText.trim();    // 结帐ID
                    if (prescriptionId) {
                        prescriptionIds.push(prescriptionId);
                        checkoutIds.push(checkoutId);
                    }
                });

                fetch('@Url.Action("Dispense", "Pharmacy")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prescriptionIds: prescriptionIds, checkoutIds: checkoutIds })
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    alert(data.msg);
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(function (err) {
                    alert('发药失败：' + err);
                });
            });
            </text>
        }
    </script>

</body>
</html>
