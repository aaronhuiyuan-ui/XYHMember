
@{
    ViewBag.Title = "Update";
}

@Styles.Render("~/Content/upcss")



<html>
<head>
    <meta charset="UTF-8">
    <title></title>
    <link rel="stylesheet" href="css/amazeui.min.css">
    <link rel="stylesheet" href="css/admin.css">
    <link rel="stylesheet" href="css/app.css">
    <style>
        .admin-main {
            padding-top: 0px;
        }
    </style>
</head>
<body>
    <div class="am-cf admin-main">
        <!-- content start -->
        <div class="admin-content">
            <div class="admin-content-body">
                <div class="am-g">
                    <form class="am-form am-form-horizontal" action="@Url.Action("UpdatePwd", "User")" method="post" style="padding-top:30px;" data-am-validator="">
                        <div class="am-form-group">
                            <label for="user-name" class="am-u-sm-3 am-form-label">
                                新密码
                            </label>
                            <div class="am-u-sm-9">
                                <input type="password" id="doc-vld-pwd-1" required="" placeholder="请输入新密码" name="password"> <small>输入新密码。</small>
                            </div>
                        </div>
                        <div class="am-form-group">
                            <label for="user-name" class="am-u-sm-3 am-form-label">
                                重复密码
                            </label>
                            <div class="am-u-sm-9">
                                <input type="password" id="doc-vld-pwd-2" required="" placeholder="请输入重复密码" name="pwd" data-equal-to="#doc-vld-pwd-1" onblur="check2pwd()"> <small>输入重复密码。</small>
                            </div>
                        </div>
                        <div class="am-form-group">
                            <div class="am-u-sm-9 am-u-sm-push-3">
                                <input type="submit" class="am-btn am-btn-success" value="修改密码">
                                <input type="hidden" name="id" value="@Model" />                                
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @Scripts.Render("~/Scripts/jquery")
    @Scripts.Render("~/Scripts/plugs")

    <script>
        function check2pwd() {
            const input1 = document.getElementById("doc-vld-pwd-1").value;
            const input2 = document.getElementById("doc-vld-pwd-2").value;
            if (input1 !== input2) {
                alert("两次输入密码不一致！");
                document.getElementById("doc-vld-pwd-1").value = "";
                document.getElementById("doc-vld-pwd-2").value = "";
            }
        }
    </script>


</body>
</html>