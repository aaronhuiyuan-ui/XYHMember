﻿﻿
@{
    ViewBag.Title = "PhysicalExamQuery";
}

@using XYHMember.Context;
@model List<HealthExamPatient>

@{
    var name = Request["name"];
    var bdatepicker = Request["bdatepicker"] ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd");
    var edatepicker = Request["edatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")

</head>

<body>
    <div>

        <div class="container">
            <div style="margin-left:300px;">
                <form controller="Outpatient" action="GetPhysicalExamQuery" method="get">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;">
                        <label style="margin:0 5px 0 10px;">检查日期</label>
                        <input type="text" name="bdatepicker" id="bdatepicker"
                               value="@bdatepicker" placeholder="开始日期" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" name="edatepicker" id="edatepicker"
                               value="@edatepicker" placeholder="结束日期" style="height:30px;">
                        <input type="text" class="am-form-field" name="name" value="@name" placeholder="姓名/身份证号" style="width:180px;margin-left:10px;">
                        <span class="am-input-group-btn">
                            <button class="am-btn am-btn-default" type="submit">查询</button>
                            <button class="am-btn am-btn-primary" type="button" id="saveBtn" style="margin-left:15px;background:#51a351!important;border-color:#51a351!important;color:#fff!important;" disabled>保存到门诊</button>
                        </span>
                    </div>
                </form>
            </div>
        </div>
        <div class="am-g">
            <div class="am-u-sm-12">

                <div class="table-wrapper" style="overflow:auto;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th class="table-chck"><input type="checkbox"></th>
                            <th class="table-title">体检号</th>
                            <th class="table-author">姓名</th>
                            <th>身份证号</th>
                            <th>检查日期</th>
                            <th>门诊号</th>
                            <th>电话</th>
                            <th>住址</th>
                        </tr>
                    </thead>
                    @if (Model != null && Model.Count > 0)
                    {
                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td><input type="checkbox"></td>
                                    <td>@result.体检号</td>
                                    <td>@result.姓名</td>
                                    <td>@result.身份证号</td>
                                    <td>@result.检查日期</td>
                                    <td>@result.门诊号</td>
                                    <td>@result.电话</td>
                                    <td>@result.住址</td>
                                </tr>
                            }
                        </tbody>
                    }
                </table>
                </div>

                @if (Model != null && Model.Count > 1)
                {
                    <div id="paginationContainer"></div>
                }

            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@bdatepicker"
        });
        flatpickr("#edatepicker", {
            dateFormat: "Y-m-d",
            defaultDate: "@edatepicker"
        });

        //表单提交前校验必须输入姓名或身份证号
        document.querySelector('form').addEventListener('submit', function (e) {
            var nameInput = this.querySelector('input[name="name"]');
            if (!nameInput.value.trim()) {
                e.preventDefault();
                alert('请输入姓名或身份证号');
            }
        });

        initTablePagination('dataTable');

        document.querySelector('#dataTable thead input[type=checkbox]').addEventListener('change', function () {
            var checked = this.checked;
            document.querySelectorAll('#dataTable tbody input[type=checkbox]').forEach(function (cb) {
                cb.checked = checked;
            });
        });

        //有数据时才启用保存按钮
        @if (Model != null && Model.Count > 0)
        {
            <text>
            var saveBtn = document.getElementById('saveBtn');
            saveBtn.disabled = false;

            saveBtn.addEventListener('click', function () {
                var checkedBoxes = document.querySelectorAll('#dataTable tbody input[type=checkbox]:checked');
                if (checkedBoxes.length === 0) {
                    alert('请选择体检病人信息');
                    return;
                }

                var hasMzh = false;
                checkedBoxes.forEach(function (cb) {
                    var row = cb.closest('tr');
                    var mzh = row.children[5].innerText.trim();
                    if (mzh !== '') {
                        hasMzh = true;
                    }
                });

                if (hasMzh) {
                    alert('请去掉已有门诊号');
                    return;
                }

                var idCards = [];
                checkedBoxes.forEach(function (cb) {
                    var row = cb.closest('tr');
                    idCards.push(row.children[4].innerText.trim());
                });
                var unique = new Set(idCards);
                if (unique.size < idCards.length) {
                    alert('同一个身份证号请仅选择一条');
                    return;
                }

                var studyIds = [];
                checkedBoxes.forEach(function (cb) {
                    var row = cb.closest('tr');
                    studyIds.push(row.children[1].innerText.trim());
                });

                fetch('@Url.Action("SaveToOutpatient", "Outpatient")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ studyIds: studyIds })
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    alert(data.msg);
                    if (data.success) {
                        location.reload();
                    }
                })
                .catch(function (err) {
                    alert('保存失败：' + err);
                });
            });
            </text>
        }
    </script>

</body>
</html>
