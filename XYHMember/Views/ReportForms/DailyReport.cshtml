
@{
    ViewBag.Title = "DailyReport";
}

@{
    var bdatepicker = Request.QueryString["bdatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edatepicker = Request.QueryString["edatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var name = Request["name"];
}

@using System.Linq

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/flatpickr")
    @Styles.Render("~/Content/my")
    <style>
        #dailyTable {
            width: 3000px !important;
            min-width: 3000px !important;
            table-layout: auto !important;
        }
        #dailyTable th,
        #dailyTable td {
            padding: 6px 8px !important;
        }
        #dailyTable th:last-child,
        #dailyTable td:last-child {
            padding-right: 100px !important;
        }
        .table-wrapper {
            overflow: auto !important;
            max-width: calc(100vw - 40px) !important;
        }
        .table-wrapper > table {
            display: table !important;
        }
        /* 列设置弹窗 */
        @@keyframes colsettings-fadein {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        @@keyframes colsettings-slidein {
            from { opacity: 0; transform: translateY(-30px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .colsettings-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            animation: colsettings-fadein 0.2s ease;
        }
        .colsettings-overlay.active {
            display: flex;
        }
        .colsettings-box {
            background: #fff;
            border-radius: 8px;
            width: 500px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 12px 48px rgba(0,0,0,0.25);
            animation: colsettings-slidein 0.25s ease;
        }
        .colsettings-header {
            padding: 16px 24px;
            background: linear-gradient(135deg, #0e90d2 0%, #0a6fa8 100%);
            border-radius: 8px 8px 0 0;
            font-size: 16px;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #fff;
            letter-spacing: 1px;
            user-select: none;
        }
        .colsettings-header .close {
            cursor: pointer;
            font-size: 22px;
            color: rgba(255,255,255,0.75);
            line-height: 1;
            transition: all 0.2s;
        }
        .colsettings-header .close:hover {
            color: #fff;
            transform: rotate(90deg);
        }
        .colsettings-body {
            padding: 8px 0;
            overflow-y: auto;
            flex: 1;
        }
        .colsettings-item {
            display: flex;
            align-items: center;
            padding: 10px 24px;
            transition: background 0.15s;
            border-bottom: 1px solid #f4f4f4;
        }
        .colsettings-item:hover {
            background: #f0f9ff;
        }
        .colsettings-item label {
            margin-left: 10px;
            cursor: pointer;
            font-weight: normal;
            font-size: 14px;
            color: #333;
            flex: 1;
            user-select: none;
        }
        .colsettings-item input[type="checkbox"] {
            cursor: pointer;
            width: 18px;
            height: 18px;
            accent-color: #0e90d2;
            flex-shrink: 0;
        }
        .colsettings-footer {
            padding: 14px 24px;
            border-top: 1px solid #e9e9e9;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            align-items: center;
            background: #fafafa;
            border-radius: 0 0 8px 8px;
        }
        .colsettings-footer button {
            padding: 7px 20px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s;
            outline: none;
        }
        .colsettings-footer .btn-reset {
            margin-right: auto;
            border: 1px solid #e6a23c;
            background: #fff;
            color: #e6a23c;
        }
        .colsettings-footer .btn-reset:hover {
            background: #e6a23c;
            color: #fff;
        }
        .colsettings-footer .btn-cancel {
            border: 1px solid #d0d0d0;
            background: #fff;
            color: #666;
        }
        .colsettings-footer .btn-cancel:hover {
            border-color: #b0b0b0;
            background: #f5f5f5;
        }
        .colsettings-footer .btn-primary {
            border: 1px solid #0e90d2;
            background: #0e90d2;
            color: #fff;
        }
        .colsettings-footer .btn-primary:hover {
            background: #0a7ec4;
            border-color: #0a7ec4;
            box-shadow: 0 2px 8px rgba(14,144,210,0.4);
        }
        .colsettings-footer button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            box-shadow: none;
        }
        /* 修改弹窗 */
        /* 这个弹窗比列设置高，覆盖掉 .colsettings-overlay 的垂直居中，往上提一点 */
        #editOverlay {
            align-items: flex-start;
            padding-top: 56px;
        }
        .edit-row {
            display: flex;
            align-items: center;
            margin-bottom: 14px;
        }
        .edit-row label {
            width: 72px;
            flex-shrink: 0;
            margin: 0 12px 0 0;
            font-size: 14px;
            font-weight: normal;
            color: #333;
            text-align: right;
        }
        /* 用 > 限定直接子元素，免得影响下面支付记录表格里的输入框 */
        .edit-row > input {
            flex: 1;
            height: 34px;
            padding: 0 10px;
            border: 1px solid #d0d0d0;
            border-radius: 4px;
            font-size: 14px;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }
        .edit-row > input:focus {
            border-color: #0e90d2;
        }
        .edit-row > input[readonly],
        .edit-row > input:disabled {
            background: #f5f5f5;
            color: #999;
            cursor: not-allowed;
        }
        .edit-row-top {
            align-items: flex-start;
        }
        .edit-row-top > label {
            padding-top: 9px;
        }
        /* 支付记录逐条列出：流水号 / 支付方式 / 备注原文 */
        .edit-pay-wrap {
            flex: 1;
            min-width: 0;
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #e0e0e0;
            border-radius: 4px;
        }
        .edit-pay-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 13px;
        }
        .edit-pay-table th {
            position: sticky;
            top: 0;
            padding: 7px 8px;
            background: #f7f7f7;
            border-bottom: 1px solid #e0e0e0;
            text-align: left;
            font-weight: 600;
            color: #555;
            white-space: nowrap;
        }
        .edit-pay-table td {
            padding: 5px 8px;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: middle;
        }
        .edit-pay-table tr:last-child td {
            border-bottom: none;
        }
        .edit-pay-table .edit-pay-id {
            color: #666;
            font-family: Consolas, monospace;
        }
        .edit-pay-table input,
        .edit-pay-table select {
            width: 100%;
            height: 30px;
            padding: 0 8px;
            border: 1px solid #d0d0d0;
            border-radius: 4px;
            font-size: 13px;
            outline: none;
            box-sizing: border-box;
        }
        .edit-pay-table select {
            padding: 0 2px;
            background: #fff;
            cursor: pointer;
        }
        .edit-pay-table input:focus,
        .edit-pay-table select:focus {
            border-color: #0e90d2;
        }
        .edit-pay-table input:disabled,
        .edit-pay-table select:disabled {
            background: #f5f5f5;
            color: #999;
            cursor: not-allowed;
        }
        .edit-pay-table .edit-pay-empty {
            padding: 18px 8px;
            text-align: center;
            color: #999;
        }
        .edit-tip {
            min-height: 18px;
            font-size: 13px;
            line-height: 18px;
            color: #666;
        }
        .edit-tip.error { color: #e74c3c; }
        .edit-tip.ok { color: #27ae60; }
        /* 滚动条美化 */
        .colsettings-body::-webkit-scrollbar {
            width: 6px;
        }
        .colsettings-body::-webkit-scrollbar-track {
            background: transparent;
        }
        .colsettings-body::-webkit-scrollbar-thumb {
            background: #d0d0d0;
            border-radius: 3px;
        }
        .colsettings-body::-webkit-scrollbar-thumb:hover {
            background: #aaa;
        }
    </style>

</head>

