    <script>
    // 列设置功能
    var columnDefs = [];

    function loadColumnDefs() {
        var ths = document.querySelectorAll('#dailyTable thead th');
        columnDefs = [];
        // 从索引1开始（跳过序号列）
        for (var i = 1; i < ths.length; i++) {
            columnDefs.push({ index: i, name: ths[i].innerText.trim() });
        }
    }

    function openColumnSettings() {
        loadColumnDefs();
        var saved = localStorage.getItem('dailyReportColumnVisibility');
        var settings = saved ? JSON.parse(saved) : {};
        var html = '';
        for (var i = 0; i < columnDefs.length; i++) {
            var col = columnDefs[i];
            var checked = settings[col.name] !== undefined ? settings[col.name] : true;
            html += '<div class="colsettings-item">' +
                '<input type="checkbox" id="col_' + i + '" ' + (checked ? 'checked' : '') + ' data-colindex="' + col.index + '">' +
                '<label for="col_' + i + '">' + col.name + '</label>' +
                '</div>';
        }
        document.getElementById('colSettingsBody').innerHTML = html;
        document.getElementById('colSettingsOverlay').classList.add('active');
    }

    function closeColSettings() {
        document.getElementById('colSettingsOverlay').classList.remove('active');
    }

    function saveColumnSettings() {
        var settings = {};
        var items = document.querySelectorAll('#colSettingsBody .colsettings-item');
        items.forEach(function(item) {
            var cb = item.querySelector('input[type="checkbox"]');
            var label = item.querySelector('label');
            settings[label.textContent] = cb.checked;
        });
        localStorage.setItem('dailyReportColumnVisibility', JSON.stringify(settings));
        applyColumnSettings(settings);
        closeColSettings();
    }

    function applyColumnSettings(settings) {
        var ths = document.querySelectorAll('#dailyTable thead th');
        var tbody = document.querySelector('#dailyTable tbody');
        for (var i = 1; i < ths.length; i++) {
            var colName = ths[i].innerText.trim();
            var visible = settings[colName] !== undefined ? settings[colName] : true;
            var display = visible ? '' : 'none';
            ths[i].style.display = display;
            if (tbody) {
                var rows = tbody.querySelectorAll('tr');
                rows.forEach(function(tr) {
                    var td = tr.children[i];
                    if (td) td.style.display = display;
                });
            }
        }
    }

    function resetColumnSettings() {
        localStorage.removeItem('dailyReportColumnVisibility');
        location.reload();
    }

    function initColumnSettings() {
        var saved = localStorage.getItem('dailyReportColumnVisibility');
        if (saved) {
            try {
                var settings = JSON.parse(saved);
                applyColumnSettings(settings);
            } catch (e) {}
        }
    }

    // 绑定列设置按钮事件
    document.getElementById('colSettingsBtn').addEventListener('click', openColumnSettings);

    // 页面加载时应用保存的列设置
    initColumnSettings();
    </script>

    <script>
    // 修改功能：结帐ID 回车载入 → 改动关联销售/支付方式/备注 → 保存
    var editBillId = null;   // 只有成功载入过才允许保存，避免误改
    var editIs收费 = false;

    // 支付方式下拉项，对标日报表 SQL 的 CASE WHEN 口径，改到范围外这行会掉出报表
    // 1 在报表里那列的表头就是"二维码"（模型属性名还叫 POS）
    var payTypes = [
        { code: 0, name: '现金' }, { code: 1, name: '二维码' }, { code: 4, name: '储值卡' },
        { code: 6, name: '折扣' }, { code: 31, name: '微信' }, { code: 32, name: '支付宝' }
    ];

    function escapeAttr(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function payTypeOptions(selected) {
        var html = '';
        for (var i = 0; i < payTypes.length; i++) {
            html += '<option value="' + payTypes[i].code + '"' +
                (payTypes[i].code === selected ? ' selected' : '') + '>' +
                payTypes[i].name + '</option>';
        }
        return html;
    }

    // 逐条列出支付记录：支付方式给下拉，备注给原文（不做 [备注:值] 标记解析）
    function renderPayments(payments, canEdit) {
        var tbody = document.getElementById('editPayBody');
        if (!payments || payments.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" class="edit-pay-empty">该结帐ID 没有支付记录</td></tr>';
            return;
        }
        var off = canEdit ? '' : ' disabled';
        var html = '';
        for (var i = 0; i < payments.length; i++) {
            var p = payments[i];
            html += '<tr>' +
                '<td class="edit-pay-id">' + p.流水号 + '</td>' +
                '<td><select class="edit-pay-type"' + off + '>' + payTypeOptions(p.支付方式) + '</select></td>' +
                '<td><input type="text" class="edit-pay-note" value="' + escapeAttr(p.备注) + '"' + off + '></td>' +
                '</tr>';
        }
        tbody.innerHTML = html;
    }

    // 挂号行不给改关联销售：挂号发票表.工作组号 是 char(2) 存不下姓名，报表分支也写死空串
    function applyEditEditable() {
        document.getElementById('editSales').disabled = !editIs收费;
        var 有支付记录 = document.querySelectorAll('#editPayBody .edit-pay-type').length > 0;
        document.getElementById('editSaveBtn').disabled = !(editIs收费 || 有支付记录);
    }

    function openEditDialog() {
        editBillId = null;
        editIs收费 = false;
        document.getElementById('editBillId').value = '';
        document.getElementById('editCategory').value = '';
        document.getElementById('editSales').value = '';
        renderPayments([], false);
        applyEditEditable();
        setEditTip('输入结帐ID后按回车载入，载入成功后才能保存', '');
        document.getElementById('editOverlay').classList.add('active');
        setTimeout(function () { document.getElementById('editBillId').focus(); }, 50);
    }

    function closeEditDialog() {
        document.getElementById('editOverlay').classList.remove('active');
    }

    function setEditTip(text, cls) {
        var el = document.getElementById('editTip');
        el.textContent = text || '';
        el.className = 'edit-tip' + (cls ? ' ' + cls : '');
    }

    function loadEditInfo() {
        var billId = document.getElementById('editBillId').value.trim();
        if (!/^-?\d+$/.test(billId)) {
            editBillId = null;
            editIs收费 = false;
            renderPayments([], false);
            applyEditEditable();
            setEditTip('请输入数字结帐ID', 'error');
            return;
        }
        setEditTip('查询中…', '');
        fetch('@Url.Action("GetDailyReportEditInfo", "ReportForms")?结帐ID=' + encodeURIComponent(billId))
            .then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data || !data.success) {
                    editBillId = null;
                    editIs收费 = false;
                    document.getElementById('editCategory').value = '';
                    document.getElementById('editSales').value = '';
                    renderPayments([], false);
                    applyEditEditable();
                    setEditTip((data && data.msg) || '未找到该结帐ID', 'error');
                    return;
                }
                document.getElementById('editCategory').value = data.category;
                document.getElementById('editSales').value = data.sales || '';
                editIs收费 = data.category === '收费';
                editBillId = billId;
                renderPayments(data.payments, true);
                applyEditEditable();

                var 条数 = (data.payments || []).length;
                if (editIs收费) {
                    setEditTip(条数 === 0
                        ? '该结帐ID 没有支付记录，只能改关联销售'
                        : '已载入 ' + 条数 + ' 条支付记录，可改关联销售、支付方式与备注', 'ok');
                } else if (条数 === 0) {
                    // 挂号行不是查询失败，只是没东西可改，提示用中性色，别跟"未找到结帐ID"混在一起
                    setEditTip('挂号行没有支付记录，无可修改内容', '');
                } else {
                    setEditTip('挂号行 ' + 条数 + ' 条支付记录，可改支付方式与备注（关联销售不支持）', 'ok');
                }
            })
            .catch(function (err) { setEditTip('查询失败：' + err.message, 'error'); });
    }

    function saveEditDialog() {
        if (!editBillId) { setEditTip('请先输入结帐ID并按回车载入', 'error'); return; }

        var rows = [];
        var trs = document.querySelectorAll('#editPayBody tr');
        for (var i = 0; i < trs.length; i++) {
            var sel = trs[i].querySelector('.edit-pay-type');
            var inp = trs[i].querySelector('.edit-pay-note');
            if (!sel || !inp) continue; // 没有支付记录时是占位行
            rows.push({
                流水号: parseInt(trs[i].cells[0].textContent, 10),
                支付方式: parseInt(sel.value, 10),
                备注: inp.value
            });
        }

        var btn = document.getElementById('editSaveBtn');
        btn.disabled = true;
        fetch('@Url.Action("SaveDailyReportEdit", "ReportForms")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: '结帐ID=' + encodeURIComponent(editBillId) +
                  '&关联销售=' + encodeURIComponent(document.getElementById('editSales').value.trim()) +
                  '&支付记录Json=' + encodeURIComponent(JSON.stringify(rows))
        })
            .then(function (r) { return r.json(); })
            .then(function (data) {
                btn.disabled = false;
                if (!data || !data.success) {
                    setEditTip((data && data.msg) || '保存失败', 'error');
                    return;
                }
                customDialog.success(data.msg, '保存成功', function () { location.reload(); });
            })
            .catch(function (err) {
                btn.disabled = false;
                setEditTip('保存失败：' + err.message, 'error');
            });
    }

    document.getElementById('editBtn').addEventListener('click', openEditDialog);
    document.getElementById('editBillId').addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.keyCode === 13) {
            e.preventDefault();
            loadEditInfo();
        }
    });
    </script>

</body>
</html>

