@{
    Layout = null;
    var bdate = Request["bdate"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edate = Request["edate"] ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<html>
<head>
    <meta charset="UTF-8">
    <title>耗材入库查询</title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")
    <style>
        #dataTable {
            width: 80% !important;
            min-width: 600px !important;
            table-layout: auto !important;
            white-space: nowrap;
        }
        #dataTable th,
        #dataTable td {
            padding: 2px 6px !important;
        }
        .table-wrapper {
            overflow: auto !important;
            max-width: calc(100vw - 40px) !important;
        }
        .table-wrapper > table {
            display: table !important;
        }
        .summary-row td { font-weight: bold; border-top: 2px solid #999; }
    </style>
</head>
<body>
    <div>
        <div class="container">
            <div style="margin-left:100px;">
                <form id="searchForm">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;">
                        <label style="margin:0 5px 0 10px;">入库日期</label>
                        <input type="text" name="bdate" id="bdatepicker"
                               value="@bdate" placeholder="开始日期" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" name="edate" id="edatepicker"
                               value="@edate" placeholder="结束日期" style="height:30px;">
                        <label style="margin:0 10px 0 20px;">关键字</label>
                        <input type="text" id="searchKw" value=""
                               placeholder="物料编码/物料名称/拼音首字母" style="width:220px;height:30px;">
                        <span style="margin-left:20px;display:inline-flex;align-items:center;gap:6px;">
                            <span class="am-input-group-btn">
                                <button class="am-btn am-btn-default" type="button" onclick="doSearch()">查询</button>
                            </span>
                        </span>
                    </div>
                </form>
            </div>
        </div>
        <div class="am-g">
            <div class="am-u-sm-12">

                <div class="table-wrapper" style="overflow:auto;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th>入库日期</th>
                            <th>单号</th>
                            <th>仓库</th>
                            <th>物料编码</th>
                            <th>物料名称</th>
                            <th>规格</th>
                            <th>产地编码</th>
                            <th>产地名称</th>
                            <th>批号</th>
                            <th>有效期</th>
                            <th>单位</th>
                            <th>数量</th>
                            <th>入库人</th>
                            <th>物料类别</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr><td colspan="14" style="text-align:center;color:#999;">加载中...</td></tr>
                    </tbody>
                </table>
                </div>

                <div id="paginationContainer"></div>

            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    <script src="~/Scripts/customDialog.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", { dateFormat: "Y-m-d", defaultDate: "@bdate" });
        flatpickr("#edatepicker", { dateFormat: "Y-m-d", defaultDate: "@edate" });

        // 关键字输入框回车触发查询
        document.getElementById('searchKw').addEventListener('keydown', function (e) {
            if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
        });

        function escapeHtml(v) {
            if (v === null || v === undefined) return '';
            return String(v)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        // ===== 查询 =====
        function doSearch() {
            var bdate = document.getElementById('bdatepicker').value;
            var edate = document.getElementById('edatepicker').value;
            var kw = document.getElementById('searchKw').value;

            fetch('@Url.Action("GetMaterialInbound", "MedicalTech")?bdate=' + encodeURIComponent(bdate) +
                  '&edate=' + encodeURIComponent(edate) + '&kw=' + encodeURIComponent(kw))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data && data.success === false) {
                        document.getElementById('tableBody').innerHTML =
                            '<tr><td colspan="14" style="text-align:center;color:red;">查询失败：' + escapeHtml(data.msg) + '</td></tr>';
                    } else {
                        renderTable(data);
                    }
                })
                .catch(function(err) {
                    document.getElementById('tableBody').innerHTML =
                        '<tr><td colspan="14" style="text-align:center;color:red;">查询失败：' + escapeHtml(err.message) + '</td></tr>';
                });
        }

        function renderTable(data) {
            var tbody = document.getElementById('tableBody');
            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="14" style="text-align:center;color:#999;">暂无数据</td></tr>';
                return;
            }

            var html = '';
            var totalSl = 0;
            for (var i = 0; i < data.length; i++) {
                var d = data[i];
                totalSl += (d.sl != null ? Number(d.sl) : 0);

                html += '<tr>' +
                    '<td>' + escapeHtml(d.ckrq) + '</td>' +
                    '<td>' + escapeHtml(d.ckdh) + '</td>' +
                    '<td>' + escapeHtml(d.ckmc) + '</td>' +
                    '<td>' + escapeHtml(d.wlbm) + '</td>' +
                    '<td>' + escapeHtml(d.wlmc) + '</td>' +
                    '<td>' + escapeHtml(d.gg) + '</td>' +
                    '<td>' + escapeHtml(d.cdbm) + '</td>' +
                    '<td>' + escapeHtml(d.cdmc) + '</td>' +
                    '<td>' + escapeHtml(d.ph) + '</td>' +
                    '<td>' + escapeHtml(d.xq) + '</td>' +
                    '<td>' + escapeHtml(d.dw) + '</td>' +
                    '<td>' + (d.sl != null ? Number(d.sl) : '') + '</td>' +
                    '<td>' + escapeHtml(d.ckr) + '</td>' +
                    '<td>' + escapeHtml(d.wllb) + '</td>' +
                    '</tr>';
            }

            html += '<tr class="summary-row" style="background:#f0f0f0;font-weight:bold;">' +
                '<td>合计</td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>' +
                '<td>' + totalSl + '</td><td></td><td></td>' +
                '</tr>';

            tbody.innerHTML = html;
            window._queryData = data;
            initTablePagination('dataTable', { summaryRows: 1 });
        }

        // 默认载入当天
        doSearch();
    </script>
</body>
</html>
