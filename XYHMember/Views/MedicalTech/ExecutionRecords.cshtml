@{
    Layout = null;
    var bdate = Request["bdate"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edate = Request["edate"] ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")
    <style>
        #dataTable {
            width: 80% !important;
            min-width: 600px !important;
            table-layout: auto !important;
            white-space: nowrap;
        }
        #dataTable th,
        #dataTable td {
            padding: 2px 4px !important;
        }
        .table-wrapper {
            overflow: auto !important;
            max-width: calc(100vw - 40px) !important;
        }
        .table-wrapper > table {
            display: table !important;
        }
        .summary-row td { font-weight: bold; border-top: 2px solid #999; }
    </style>
</head>
<body>
    <div>

        <div class="container">
            <div style="margin-left:100px;">
                <form id="searchForm">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;">
                        <label style="margin:0 5px 0 10px;">执行时间</label>
                        <input type="text" name="bdate" id="bdatepicker"
                               value="@bdate" placeholder="开始日期" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" name="edate" id="edatepicker"
                               value="@edate" placeholder="结束日期" style="height:30px;">
                        <span style="margin-left:40px;display:inline-flex;align-items:center;gap:6px;">
                            <input type="text" class="am-form-field" name="name" id="searchName" value="" placeholder="病人姓名或项目名称" style="width:200px;">
                            <span class="am-input-group-btn">
                                <button class="am-btn am-btn-default" type="button" onclick="doSearch()">查询</button>
                                <button class="am-btn am-btn-default" type="button" id="exportBtn" style="margin-left:10px;">导出到Excel</button>
                            </span>
                    </div>
                </form>
            </div>
        </div>
        <div class="am-g">
            <div class="am-u-sm-12">

                <div class="table-wrapper" style="overflow:auto;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th>执行时间</th>
                            <th>病人姓名</th>
                            <th>项目名称</th>
                            <th>本次执行次数</th>
                            <th>本次执行金额</th>
                            <th>总次数</th>
                            <th>进度</th>
                            <th>执行人</th>
                            <th>岗位</th>
                            <th>备注</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr><td colspan="10" style="text-align:center;color:#999;">加载中...</td></tr>
                    </tbody>
                </table>
                </div>

                <div id="paginationContainer"></div>

            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    <script src="~/Scripts/customDialog.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", { dateFormat: "Y-m-d", defaultDate: "@bdate" });
        flatpickr("#edatepicker", { dateFormat: "Y-m-d", defaultDate: "@edate" });

        // ===== 查询 =====
        function doSearch() {
            var bdate = document.getElementById('bdatepicker').value;
            var edate = document.getElementById('edatepicker').value;
            var name = document.getElementById('searchName').value;

            fetch('@Url.Action("GetExecutionRecords", "MedicalTech")?bdate=' + encodeURIComponent(bdate) +
                  '&edate=' + encodeURIComponent(edate) + '&name=' + encodeURIComponent(name))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data && data.success === false) {
                        document.getElementById('tableBody').innerHTML =
                            '<tr><td colspan="10" style="text-align:center;color:red;">查询失败：' + data.msg + '</td></tr>';
                    } else {
                        renderTable(data);
                    }
                })
                .catch(function(err) {
                    document.getElementById('tableBody').innerHTML =
                        '<tr><td colspan="10" style="text-align:center;color:red;">查询失败：' + err.message + '</td></tr>';
                });
        }

        function renderTable(data) {
            var tbody = document.getElementById('tableBody');
            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;color:#999;">暂无执行记录</td></tr>';
                return;
            }

            var html = '';
            for (var i = 0; i < data.length; i++) {
                var d = data[i];
                var execAmt = d.本次执行金额 != null ? d.本次执行金额 : 0;

                html += '<tr>' +
                    '<td>' + escapeHtml(d.执行时间) + '</td>' +
                    '<td>' + escapeHtml(d.病人姓名) + '</td>' +
                    '<td>' + escapeHtml(d.项目名称) + '</td>' +
                    '<td>' + d.本次执行次数 + '次</td>' +
                    '<td>' + execAmt.toFixed(2) + '</td>' +
                    '<td>' + (d.总次数 != null ? d.总次数 : '-') + '</td>' +
                    '<td>' + d.最新本次次数 + '/' + (d.总次数 != null ? d.总次数 : '?') + '</td>' +
                    '<td>' + escapeHtml(d.执行人姓名) + '</td>' +
                    '<td>' + escapeHtml(d.岗位) + '</td>' +
                    '<td>' + escapeHtml(d.备注) + '</td>' +
                    '</tr>';
            }
            // 合计（仅合计本次执行金额）
            var sum已执行金额 = 0;
            for (var i = 0; i < data.length; i++) {
                sum已执行金额 += (data[i].本次执行金额 != null ? data[i].本次执行金额 : 0);
            }

            html += '<tr class="summary-row" style="background:#f0f0f0;font-weight:bold;">' +
                '<td>合计</td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '<td>' + sum已执行金额.toFixed(2) + '</td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '<td></td>' +
                '</tr>';

            tbody.innerHTML = html;
            window._queryData = data;
            initTablePagination('dataTable', { summaryRows: 1 });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ===== 导出到Excel =====
        document.getElementById('exportBtn').addEventListener('click', function() {
            var headers = ['执行时间', '病人姓名', '项目名称', '本次执行次数', '本次执行金额', '总次数', '进度', '执行人', '岗位', '备注'];
            var rows = [];
            var trs = document.querySelectorAll('#dataTable tbody tr');
            for (var i = 0; i < trs.length; i++) {
                if (trs[i].classList.contains('summary-row')) continue;
                var tds = trs[i].querySelectorAll('td');
                if (tds.length < 10) continue;
                var row = [];
                for (var c = 0; c < 10; c++) {
                    row.push(tds[c].innerText.trim());
                }
                rows.push(row);
            }
            if (rows.length === 0) {
                customDialog.info('没有数据可导出', '提示');
                return;
            }

            fetch('@Url.Action("ExportToExcel", "Export")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Headers: headers, Rows: rows })
            })
            .then(function(res) { return res.blob(); })
            .then(function(blob) {
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = '医技执行记录.xlsx';
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            })
            .catch(function(err) { customDialog.error(err.message, '导出失败'); });
        });

        // 回车查询
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !document.querySelector('.modal-overlay.active')) {
                doSearch();
                e.preventDefault();
            }
        });

        // 初始化加载
        doSearch();
    </script>

</body>
</html>
