@{
    ViewBag.Title = "医技登记与执行";
    var bdatepicker = Request["bdatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edatepicker = Request["edatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var name = Request["name"] ?? "";
}

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")
    <style>
        #dataTable {
            width: 80% !important;
            min-width: 600px !important;
            table-layout: auto !important;
            white-space: nowrap;
        }
        #dataTable th,
        #dataTable td {
            padding: 2px 4px !important;
        }
        #dataTable th:last-child,
        #dataTable td:last-child {
            padding-right: 8px !important;
        }
        .table-wrapper {
            overflow: auto !important;
            max-width: calc(100vw - 40px) !important;
        }
        .table-wrapper > table {
            display: table !important;
        }
        .status-badge {
            display: inline-block;
            padding: 1px 8px;
            border-radius: 8px;
            font-size: 12px;
        }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-active { background: #cce5ff; color: #004085; }
        .status-done { background: #d4edda; color: #155724; }
        .btn-action {
            padding: 2px 10px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 12px;
            border: 1px solid #d0d0d0;
            background: #fff;
            margin: 0 2px;
        }
        .btn-action.btn-reg { border-color: #0e90d2; color: #0e90d2; }
        .btn-action.btn-reg:hover { background: #0e90d2; color: #fff; }
        .btn-action.btn-exec { border-color: #5eb95e; color: #5eb95e; }
        .btn-action.btn-exec:hover { background: #5eb95e; color: #fff; }
        .btn-action.btn-view { border-color: #999; color: #666; }
        .btn-action.btn-view:hover { background: #666; color: #fff; }

        /* 弹窗样式 */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.4);
            z-index: 9999;
        }
        .modal-overlay.active { display: block; }
        .modal-box {
            background: #fff;
            border-radius: 4px;
            width: 420px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 16px rgba(0,0,0,0.2);
            position: absolute;
            top: 50px;
            left: 500px;
        }
        .modal-header {
            padding: 12px 16px;
            border-bottom: 1px solid #e9e9e9;
            font-size: 15px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-header .close {
            cursor: pointer;
            font-size: 20px;
            color: #999;
            line-height: 1;
        }
        .modal-header .close:hover { color: #333; }
        .modal-body { padding: 14px 16px; overflow-y: auto; flex: 1; }
        .modal-body .field { margin-bottom: 12px; }
        .modal-body label { display: block; margin-bottom: 3px; font-weight: 600; font-size: 13px; color: #555; }
        .modal-body input, .modal-body textarea {
            width: 100%; padding: 6px 8px; border: 1px solid #d0d0d0;
            border-radius: 3px; font-size: 13px; box-sizing: border-box;
        }
        .modal-body input:focus, .modal-body textarea:focus {
            border-color: #0e90d2; outline: none;
        }
        .modal-body textarea { height: 50px; resize: vertical; }
        .modal-body .field-row { display: flex; gap: 10px; }
        .modal-body .field-row .field { flex: 1; }
        .modal-body .field-readonly input { background: #f5f5f5; color: #333; }
        .modal-footer {
            padding: 10px 16px;
            border-top: 1px solid #e9e9e9;
            text-align: right;
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }
        .modal-footer button {
            padding: 5px 16px; border-radius: 3px; cursor: pointer;
            font-size: 13px; border: 1px solid #d0d0d0; background: #fff;
        }
        .modal-footer .btn-primary {
            background: #0e90d2; color: #fff; border-color: #0e90d2;
        }
        .modal-footer .btn-primary:hover { background: #0a7ec4; }

        /* 历史表格 */
        .history-table { width: 100%; border-collapse: collapse; margin-top: 6px; }
        .history-table th, .history-table td {
            padding: 4px 8px; border: 1px solid #e0e0e0; text-align: center; font-size: 13px;
        }
        .history-table th { background: #f5f5f5; font-weight: 600; }
        .summary-bar {
            margin: 8px 0; padding: 6px 12px; background: #f8f9fa;
            border-radius: 3px; font-size: 13px; border-left: 3px solid #0e90d2;
        }
    </style>
</head>
<body>
    <div>

        <div class="container">
            <div style="margin-left:100px;">
                <form id="searchForm" method="get" action="@Url.Action("GetQuery", "MedicalTech")">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;flex-wrap:wrap;">
                        <label style="margin:0 5px 0 10px;">收费日期</label>
                        <input type="text" name="bdatepicker" id="bdatepicker"
                               value="@bdatepicker" placeholder="开始日期" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" name="edatepicker" id="edatepicker"
                               value="@edatepicker" placeholder="结束日期" style="height:30px;">
                        <span style="margin-left:40px;display:inline-flex;align-items:center;gap:6px;">
                            <input type="text" class="am-form-field" name="name" value="@name" placeholder="病人姓名或项目名称" style="width:280px;">
                            <span class="am-input-group-btn">
                                <button class="am-btn am-btn-default" type="button" onclick="doSearch()">查询</button>
                            </span>
                        </span>
                    </div>
                </form>
            </div>
        </div>
        <div class="am-g">
            <div class="am-u-sm-12">

                <div class="table-wrapper" style="overflow:auto;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th>门诊号</th>
                            <th>姓名</th>
                            <th>项目名称</th>
                            <th>数量</th>
                            <th>金额</th>
                            <th>收费日期</th>
                            <th>状态</th>
                            <th>执行进度</th>
                            <th>操作</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr><td colspan="9" style="text-align:center;color:#999;">请输入查询条件后点击查询</td></tr>
                    </tbody>
                </table>
                </div>

                <div id="paginationContainer"></div>

            </div>
        </div>
    </div>

    <!-- ========== 登记弹窗 ========== -->
    <div class="modal-overlay" id="registerModal">
        <div class="modal-box">
            <div class="modal-header">
                <span>医技登记</span>
                <span class="close" onclick="closeModal('registerModal')">&times;</span>
            </div>
            <div class="modal-body">
                <div class="field field-readonly">
                    <label>病人姓名</label>
                    <input type="text" id="reg_姓名" readonly>
                </div>
                <div class="field field-readonly">
                    <label>项目名称</label>
                    <input type="text" id="reg_项目名称" readonly>
                </div>
                <div class="field">
                    <label>总次数 <span style="color:#999;font-weight:normal;">（疗程总次数）</span></label>
                    <input type="number" id="reg_总次数" value="6" min="1" max="99">
                </div>
                <input type="hidden" id="reg_结帐ID">
                <input type="hidden" id="reg_处方ID">
                <input type="hidden" id="reg_就诊ID">
                <input type="hidden" id="reg_门诊号">
            </div>
            <div class="modal-footer">
                <button onclick="closeModal('registerModal')">取消</button>
                <button class="btn-primary" onclick="submitRegister()">确认登记</button>
            </div>
        </div>
    </div>

    <!-- ========== 执行弹窗 ========== -->
    <div class="modal-overlay" id="executeModal">
        <div class="modal-box">
            <div class="modal-header">
                <span>医技执行</span>
                <span class="close" onclick="closeModal('executeModal')">&times;</span>
            </div>
            <div class="modal-body">
                <div class="field field-readonly">
                    <label>病人姓名</label>
                    <input type="text" id="exec_姓名" readonly>
                </div>
                <div class="field field-readonly">
                    <label>项目名称</label>
                    <input type="text" id="exec_项目名称" readonly>
                </div>
                <div class="field">
                    <label>执行时间</label>
                    <input type="text" id="exec_执行时间">
                </div>
                <div class="field-row">
                    <div class="field field-readonly">
                        <label>执行人工号</label>
                        <input type="text" id="exec_工号" readonly>
                    </div>
                    <div class="field field-readonly">
                        <label>执行人姓名</label>
                        <input type="text" id="exec_姓名_" readonly>
                    </div>
                </div>
                <div class="field">
                    <label>岗位</label>
                    <input type="text" id="exec_岗位" placeholder="如：针灸师">
                </div>
                <div class="field">
                    <label>备注</label>
                    <textarea id="exec_备注" placeholder="可选"></textarea>
                </div>
                <input type="hidden" id="exec_登记ID">
            </div>
            <div class="modal-footer">
                <button onclick="closeModal('executeModal')">取消</button>
                <button class="btn-primary" onclick="submitExecute()">确认执行</button>
            </div>
        </div>
    </div>

    <!-- ========== 历史记录弹窗 ========== -->
    <div class="modal-overlay" id="historyModal">
        <div class="modal-box" style="width:550px;">
            <div class="modal-header">
                <span>执行历史</span>
                <span class="close" onclick="closeModal('historyModal')">&times;</span>
            </div>
            <div class="modal-body">
                <div class="summary-bar" id="historySummary">加载中...</div>
                <table class="history-table">
                    <thead>
                        <tr><th>执行次数</th><th>执行时间</th><th>执行人</th><th>岗位</th><th>备注</th></tr>
                    </thead>
                    <tbody id="historyBody"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn-primary" onclick="closeModal('historyModal')">关闭</button>
            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", { dateFormat: "Y-m-d", defaultDate: "@bdatepicker" });
        flatpickr("#edatepicker", { dateFormat: "Y-m-d", defaultDate: "@edatepicker" });
        flatpickr("#exec_执行时间", { dateFormat: "Y-m-d H:i", enableTime: true, defaultDate: new Date() });

        // ===== 查询 =====
        function doSearch() {
            var name = document.querySelector('#searchForm input[name="name"]').value;
            var bdate = document.getElementById('bdatepicker').value;
            var edate = document.getElementById('edatepicker').value;

            fetch('@Url.Action("GetQuery", "MedicalTech")?name=' + encodeURIComponent(name) +
                  '&bdate=' + encodeURIComponent(bdate) + '&edate=' + encodeURIComponent(edate))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data && data.success === false) {
                        document.getElementById('tableBody').innerHTML =
                            '<tr><td colspan="9" style="text-align:center;color:red;">查询失败：' + data.msg + '</td></tr>';
                    } else {
                        renderTable(data);
                    }
                })
                .catch(function(err) {
                    document.getElementById('tableBody').innerHTML =
                        '<tr><td colspan="9" style="text-align:center;color:red;">查询失败：' + err.message + '</td></tr>';
                });
        }

        function renderTable(data) {
            var tbody = document.getElementById('tableBody');
            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:#999;">未找到数据</td></tr>';
                return;
            }

            var html = '';
            for (var i = 0; i < data.length; i++) {
                var d = data[i];
                var statusText, statusClass, progressText, actionHtml;

                if (d.登记ID == null) {
                    statusText = '未登记';
                    statusClass = 'status-pending';
                    progressText = '-';
                    actionHtml = '<button class="btn-action btn-reg" onclick="openRegister(' + i + ')">登记</button>';
                } else if (d.已执行次数 < d.总次数) {
                    statusText = '进行中';
                    statusClass = 'status-active';
                    progressText = d.已执行次数 + '/' + d.总次数 + '次';
                    actionHtml = '<button class="btn-action btn-exec" onclick="openExecute(' + i + ')">执行</button>' +
                                 '<button class="btn-action btn-view" onclick="openHistory(' + i + ')">查看</button>';
                } else {
                    statusText = '已完成';
                    statusClass = 'status-done';
                    progressText = d.已执行次数 + '/' + d.总次数 + '次';
                    actionHtml = '<button class="btn-action btn-view" onclick="openHistory(' + i + ')">查看</button>';
                }

                html += '<tr>' +
                    '<td>' + d.门诊号 + '</td>' +
                    '<td>' + escapeHtml(d.姓名) + '</td>' +
                    '<td>' + escapeHtml(d.项目名称) + '</td>' +
                    '<td>' + (d.数量 != null ? d.数量 : '') + '</td>' +
                    '<td>' + (d.金额 != null ? d.金额.toFixed(2) : '') + '</td>' +
                    '<td>' + d.日期 + '</td>' +
                    '<td><span class="status-badge ' + statusClass + '">' + statusText + '</span></td>' +
                    '<td>' + progressText + '</td>' +
                    '<td>' + actionHtml + '</td>' +
                    '</tr>';
            }
            tbody.innerHTML = html;
            window._queryData = data;
            initTablePagination('dataTable');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // ===== 登记 =====
        function openRegister(idx) {
            var d = window._queryData[idx];
            document.getElementById('reg_姓名').value = d.姓名;
            document.getElementById('reg_项目名称').value = d.项目名称;
            document.getElementById('reg_总次数').value = 6;
            document.getElementById('reg_结帐ID').value = d.结帐ID;
            document.getElementById('reg_处方ID').value = d.处方ID;
            document.getElementById('reg_就诊ID').value = d.就诊ID;
            document.getElementById('reg_门诊号').value = d.门诊号;
            openModal('registerModal');
        }

        function submitRegister() {
            var data = {
                结帐ID: parseInt(document.getElementById('reg_结帐ID').value),
                处方ID: parseInt(document.getElementById('reg_处方ID').value),
                就诊ID: parseInt(document.getElementById('reg_就诊ID').value),
                门诊号: parseInt(document.getElementById('reg_门诊号').value),
                病人姓名: document.getElementById('reg_姓名').value,
                项目名称: document.getElementById('reg_项目名称').value,
                总次数: parseInt(document.getElementById('reg_总次数').value) || 1
            };

            fetch('@Url.Action("Register", "MedicalTech")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    closeModal('registerModal');
                    doSearch();
                } else {
                    alert('登记失败：' + res.msg);
                }
            })
            .catch(function(err) { alert('请求失败：' + err.message); });
        }

        // ===== 执行 =====
        function openExecute(idx) {
            var d = window._queryData[idx];
            document.getElementById('exec_姓名').value = d.姓名;
            document.getElementById('exec_项目名称').value = d.项目名称;
            document.getElementById('exec_登记ID').value = d.登记ID;

            var now = new Date();
            var pad = function(n) { return n < 10 ? '0' + n : n; };
            document.getElementById('exec_执行时间').value =
                now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate()) +
                ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes());

            document.getElementById('exec_工号').value = '';
            document.getElementById('exec_姓名_').value = '';
            document.getElementById('exec_岗位').value = '';
            document.getElementById('exec_备注').value = '';

            fetch('@Url.Action("GetCurrentUser", "MedicalTech")')
                .then(function(r) { return r.json(); })
                .then(function(u) {
                    document.getElementById('exec_工号').value = u.jobNumber;
                    document.getElementById('exec_姓名_').value = u.userName;
                })
                .catch(function() {});

            openModal('executeModal');
        }

        function submitExecute() {
            var data = {
                登记ID: parseInt(document.getElementById('exec_登记ID').value),
                执行时间: document.getElementById('exec_执行时间').value,
                岗位: document.getElementById('exec_岗位').value,
                备注: document.getElementById('exec_备注').value
            };

            fetch('@Url.Action("Execute", "MedicalTech")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    closeModal('executeModal');
                    doSearch();
                } else {
                    alert('执行失败：' + res.msg);
                }
            })
            .catch(function(err) { alert('请求失败：' + err.message); });
        }

        // ===== 历史 =====
        function openHistory(idx) {
            var d = window._queryData[idx];
            if (!d.登记ID) return;

            fetch('@Url.Action("GetHistory", "MedicalTech")?登记ID=' + d.登记ID)
                .then(function(r) { return r.json(); })
                .then(function(res) {
                    if (!res.success) { alert('查询失败：' + res.msg); return; }
                    document.getElementById('historySummary').innerHTML =
                        '病人：' + res.病人姓名 + ' ｜ 项目：' + res.项目名称 +
                        ' ｜ 进度：' + res.已执行次数 + '/' + res.总次数 + '次';

                    var html = '';
                    if (res.records && res.records.length > 0) {
                        for (var i = 0; i < res.records.length; i++) {
                            var r = res.records[i];
                            var timeStr = r.执行时间 ? formatDate(r.执行时间) : '';
                            html += '<tr><td>第' + r.本次次数 + '次</td><td>' + timeStr + '</td>' +
                                '<td>' + (r.执行人姓名 || '') + '</td><td>' + (r.岗位 || '') + '</td><td>' + (r.备注 || '') + '</td></tr>';
                        }
                    } else {
                        html = '<tr><td colspan="5" style="color:#999;">暂无执行记录</td></tr>';
                    }
                    document.getElementById('historyBody').innerHTML = html;
                    openModal('historyModal');
                })
                .catch(function(err) { alert('请求失败：' + err.message); });
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;
            var pad = function(n) { return n < 10 ? '0' + n : n; };
            return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
                   ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        // ===== 弹窗控制 =====
        function openModal(id) { document.getElementById(id).classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }

        document.querySelectorAll('.modal-overlay').forEach(function(el) {
            el.addEventListener('click', function(e) {
                if (e.target === this) this.classList.remove('active');
            });
        });

        // 回车查询
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !document.querySelector('.modal-overlay.active')) {
                doSearch();
                e.preventDefault();
            }
        });
    </script>

</body>
</html>
