        function hdrOptClick() {
            var value = this.dataset.value;
            var dd = this.closest('.hdr-filter-dropdown');
            var col = dd.id.replace('hdrDropdown', '');
            // 清除所有选中样式，当前点击的项标记为选中（包括"全部"）
            dd.querySelectorAll('.hdr-filter-opt').forEach(function(o) { o.classList.remove('selected'); });
            this.classList.add('selected');
            window._hdrFilter[col] = value;
            applyHdrFilters();
            closeAllHdrDropdowns();
        }

        function applyHdrFilters() {
            if (!window._queryDataFull) return;
            var projectFilter = window._hdrFilter['项目名称'] || '';
            var statusFilter = window._hdrFilter['状态'] || '';
            var pkgFilter = window._hdrFilter['套餐名称'] || '';
            var execFilter = window._hdrFilter['执行人'] || '';

            var filtered = window._queryDataFull.filter(function(d) {
                if (projectFilter && d.项目名称 !== projectFilter) return false;
                if (pkgFilter && d.套餐名称 !== pkgFilter) return false;
                if (execFilter && d.执行人 !== execFilter) return false;
                if (statusFilter) {
                    var status = '未登记';
                    if (d.登记ID != null) {
                        status = (d.已执行次数 < d.总次数) ? '进行中' : '已完成';
                    }
                    if (status !== statusFilter) return false;
                }
                return true;
            });

            renderTable(filtered);
        }

        // 状态下拉选项固定，直接绑点击
        document.querySelectorAll('#hdrDropdown状态 .hdr-filter-opt').forEach(function(o) {
            o.addEventListener('click', hdrOptClick);
        });

        function closeAllHdrDropdowns() {
            document.querySelectorAll('.hdr-filter-dropdown').forEach(function(d) { d.classList.remove('show'); });
            document.querySelectorAll('.hdr-filter-trigger').forEach(function(t) { t.classList.remove('active'); });
        }

        document.addEventListener('click', function() { closeAllHdrDropdowns(); });

        // ===== 登记 =====
        function openRegister(idx) {
            var d = window._queryData[idx];
            document.getElementById('reg_姓名').value = d.姓名;
            document.getElementById('reg_项目名称').value = d.项目名称;
            document.getElementById('reg_结帐ID').value = d.结帐ID;
            document.getElementById('reg_处方ID').value = d.处方ID;
            document.getElementById('reg_就诊ID').value = d.就诊ID;
            document.getElementById('reg_门诊号').value = d.门诊号;

            var qty = (d.数量 != null && d.数量 > 0) ? d.数量 : 1;

            // 根据项目ID查询默认次数
            var pid = (d.项目ID != null ? d.项目ID : '');
            fetch('@Url.Action("GetDefaultCountList", "MedicalTech")?项目ID=' + encodeURIComponent(pid))
                .then(function(r) { return r.json(); })
                .then(function(list) {
                    if (list && list.length > 0 && list[0].默认总次数) {
                        document.getElementById('reg_总次数').value = list[0].默认总次数 * qty;
                    } else {
                        document.getElementById('reg_总次数').value = 1 * qty;
                    }
                })
                .catch(function() {});

            openModal('registerModal');
        }

        function submitRegister() {
            var data = {
                结帐ID: parseInt(document.getElementById('reg_结帐ID').value),
                处方ID: parseInt(document.getElementById('reg_处方ID').value),
                就诊ID: parseInt(document.getElementById('reg_就诊ID').value),
                门诊号: parseInt(document.getElementById('reg_门诊号').value),
                病人姓名: document.getElementById('reg_姓名').value,
                项目名称: document.getElementById('reg_项目名称').value,
                总次数: parseInt(document.getElementById('reg_总次数').value) || 1
            };

            fetch('@Url.Action("Register", "MedicalTech")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    closeModal('registerModal');
                    doSearch();
                } else {
                    customDialog.error(res.msg, '登记失败');
                }
            })
            .catch(function(err) { customDialog.error(err.message, '请求失败'); });
        }

        // ===== 执行 =====
        function openExecute(idx) {
            window._batchQueue = []; // 退出批量模式
            var d = window._queryData[idx];
            document.getElementById('exec_姓名').value = d.姓名;
            document.getElementById('exec_项目名称').value = d.项目名称;
            document.getElementById('exec_登记ID').value = d.登记ID;

            var now = new Date();
            var pad = function(n) { return n < 10 ? '0' + n : n; };
            document.getElementById('exec_执行时间').value =
                now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate()) +
                ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());

            document.getElementById('exec_工号').innerHTML = '<option value="">请选择</option>';
            document.getElementById('exec_姓名_').innerHTML = '<option value="">请选择</option>';
            document.getElementById('exec_岗位').value = '';
            document.getElementById('exec_备注').value = '';

            // 获取当前登录用户信息
            var currentUser = null;
            fetch('@Url.Action("GetCurrentUser", "MedicalTech")')
                .then(function(r) { return r.json(); })
                .then(function(u) {
                    currentUser = u;
                    // 再获取人员列表
                    return fetch('@Url.Action("GetStaffList", "MedicalTech")?name=');
                })
                .then(function(r) { return r.json(); })
                .then(function(staffList) {
                    if (!staffList || staffList.success === false) return;

                    var jobSelect = document.getElementById('exec_工号');
                    var nameSelect = document.getElementById('exec_姓名_');

                    // 填充下拉
                    for (var i = 0; i < staffList.length; i++) {
                        var s = staffList[i];
                        var jobOpt = document.createElement('option');
                        jobOpt.value = s.工号;
                        jobOpt.textContent = s.工号;
                        jobOpt.dataset.name = s.姓名;
                        jobOpt.dataset.position = s.岗位 || '';
                        jobSelect.appendChild(jobOpt);

                        var nameOpt = document.createElement('option');
                        nameOpt.value = s.姓名;
                        nameOpt.textContent = s.姓名;
                        nameOpt.dataset.job = s.工号;
                        nameOpt.dataset.position = s.岗位 || '';
                        nameSelect.appendChild(nameOpt);
                    }

                    // 默认选中当前登录用户
                    if (currentUser && currentUser.jobNumber) {
                        for (var i = 0; i < jobSelect.options.length; i++) {
                            if (jobSelect.options[i].value === currentUser.jobNumber) {
                                jobSelect.selectedIndex = i;
                                break;
                            }
                        }
                        // 同步姓名
                        var selOpt = jobSelect.options[jobSelect.selectedIndex];
                        if (selOpt && selOpt.dataset.name) {
                            for (var j = 0; j < nameSelect.options.length; j++) {
                                if (nameSelect.options[j].value === selOpt.dataset.name) {
                                    nameSelect.selectedIndex = j;
                                    break;
                                }
                            }
                        }
                        // 自动填充岗位
                        if (selOpt && selOpt.dataset.position) {
                            document.getElementById('exec_岗位').value = selOpt.dataset.position;
                        }
                    }
                })
                .catch(function() {});

            openModal('executeModal');
        }

        function submitExecute() {
            var 工号 = document.getElementById('exec_工号').value;
            var 姓名 = document.getElementById('exec_姓名_').value;
            if (!工号) { alert('请选择执行人工号'); return; }
            if (!姓名) { alert('请选择执行人姓名'); return; }

            var data = {
                登记ID: parseInt(document.getElementById('exec_登记ID').value),
                执行时间: document.getElementById('exec_执行时间').value,
                执行次数: parseInt(document.getElementById('exec_执行次数').value) || 1,
                执行人工号: 工号,
                执行人姓名: 姓名,
                岗位: document.getElementById('exec_岗位').value,
                备注: document.getElementById('exec_备注').value
            };

            fetch('@Url.Action("Execute", "MedicalTech")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    // 批量模式：自动跳到下一个
                    if (window._batchQueue && window._batchQueue.length > 0) {
                        window._batchQueueIndex++;
                        loadBatchItem();
                    } else {
                        closeModal('executeModal');
                        doSearch();
                    }
                } else {
                    customDialog.error(res.msg, '执行失败');
                }
            })
            .catch(function(err) { customDialog.error(err.message, '请求失败'); });
        }

        // 级联：工号变动 → 姓名、岗位联动
        document.getElementById('exec_工号').addEventListener('change', function() {
            var selOpt = this.options[this.selectedIndex];
            var nameSelect = document.getElementById('exec_姓名_');
            if (selOpt && selOpt.dataset.name) {
                for (var i = 0; i < nameSelect.options.length; i++) {
                    if (nameSelect.options[i].value === selOpt.dataset.name) {
                        nameSelect.selectedIndex = i;
                        break;
                    }
                }
                document.getElementById('exec_岗位').value = selOpt.dataset.position || '';
            } else {
                nameSelect.selectedIndex = 0;
                document.getElementById('exec_岗位').value = '';
            }
        });

        // 级联：姓名变动 → 工号联动（同名的取第一个匹配）
        document.getElementById('exec_姓名_').addEventListener('change', function() {
            var selOpt = this.options[this.selectedIndex];
            var jobSelect = document.getElementById('exec_工号');
            if (selOpt && selOpt.dataset.job) {
                for (var i = 0; i < jobSelect.options.length; i++) {
                    if (jobSelect.options[i].value === selOpt.dataset.job) {
                        jobSelect.selectedIndex = i;
                        break;
                    }
                }
                document.getElementById('exec_岗位').value = selOpt.dataset.position || '';
            } else {
                jobSelect.selectedIndex = 0;
                document.getElementById('exec_岗位').value = '';
            }
        });

        // ===== 历史 =====
        function openHistory(idx) {
            var d = window._queryData[idx];
            if (!d.登记ID) return;
            window._history登记ID = d.登记ID;

            fetch('@Url.Action("GetHistory", "MedicalTech")?登记ID=' + d.登记ID)
                .then(function(r) { return r.json(); })
                .then(function(res) {
                    if (!res.success) { customDialog.error(res.msg, '查询失败'); return; }
                    document.getElementById('historySummary').innerHTML =
                        '病人：' + res.病人姓名 + ' ｜ 项目：' + res.项目名称 +
                        ' ｜ 进度：' + res.已执行次数 + '/' + res.总次数 + '次' +
                        ' ｜ 提成：' + (res.提成金额 != null ? res.提成金额.toFixed(2) : '0.00') + '元';

                    var html = '';
                    if (res.records && res.records.length > 0) {
                        var lastIdx = res.records.length - 1;
                        for (var i = 0; i < res.records.length; i++) {
                            var r = res.records[i];
                            var timeStr = r.执行时间 ? formatDate(r.执行时间) : '';
                            var isLast = (i === lastIdx);
                            // 只有最新的一条可选择（可取消）
                            var chkDisabled = isLast ? '' : 'disabled style="opacity:0.4;"';
                            html += '<tr>' +
                                '<td><input type="checkbox" class="chk-exec" data-本次次数="' + r.本次次数 + '" ' + chkDisabled + '></td>' +
                                '<td>第' + r.本次次数 + '次</td>' +
                                '<td>' + timeStr + '</td>' +
                                '<td>' + (r.执行人姓名 || '') + '</td>' +
                                '<td>' + (r.岗位 || '') + '</td>' +
                                '<td>' + (r.备注 || '') + '</td>' +
                                '</tr>';
                        }
                    } else {
                        html = '<tr><td colspan="6" style="color:#999;">暂无执行记录</td></tr>';
                    }
                    document.getElementById('historyBody').innerHTML = html;

                    // 若有记录，最新一条默认选中，显示取消按钮
                    var cancelBtn = document.getElementById('cancelExecBtnInHistory');
                    if (res.records && res.records.length > 0) {
                        var lastChk = document.querySelector('#historyBody .chk-exec:not([disabled])');
                        if (lastChk) lastChk.checked = true;
                        cancelBtn.style.display = '';
                    } else {
                        cancelBtn.style.display = 'none';
                    }

                    openModal('historyModal');
                })
                .catch(function(err) { customDialog.error(err.message, '请求失败'); });
        }

        // ===== 取消执行 =====
        function doCancelExecution() {
            var checkedChk = document.querySelector('#historyBody .chk-exec:checked');
            if (!checkedChk) { customDialog.info('请选择要取消的执行记录', '提示'); return; }

            var 本次次数 = parseInt(checkedChk.getAttribute('data-本次次数'));
            if (!本次次数) return;

            customDialog.confirm('确定要取消第 ' + 本次次数 + ' 次执行记录吗？\n取消后该次数可重新执行。', '确认取消',
                function() {
                    fetch('@Url.Action("CancelExecution", "MedicalTech")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 登记ID: window._history登记ID, 本次次数: 本次次数 })
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(res) {
                        if (res.success) {
                            customDialog.success('第 ' + 本次次数 + ' 次执行记录已取消', '取消成功', function() {
                                // 刷新历史
                                var allData = window._queryData || [];
                                for (var i = 0; i < allData.length; i++) {
                                    if (allData[i].登记ID === window._history登记ID) {
                                        openHistory(i);
                                        return;
                                    }
                                }
                                closeModal('historyModal');
                                doSearch();
                            });
                        } else {
                            customDialog.error(res.msg, '取消失败');
                        }
                    })
                    .catch(function(err) { customDialog.error(err.message, '请求失败'); });
                }
            );
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            var d = new Date(dateStr);
            if (isNaN(d.getTime())) return dateStr;
            var pad = function(n) { return n < 10 ? '0' + n : n; };
            return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
                   ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
        }

        // ===== 弹窗控制 =====
        function openModal(id) { document.getElementById(id).classList.add('active'); }
        function closeModal(id) { document.getElementById(id).classList.remove('active'); }

        document.querySelectorAll('.modal-overlay').forEach(function(el) {
            el.addEventListener('click', function(e) {
                if (e.target === this) { this.classList.remove('active'); window._batchQueue = []; }
            });
        });

        // ===== 全选/取消全选 =====
        document.querySelector('#dataTable thead input[type=checkbox]').addEventListener('change', function() {
            var checked = this.checked;
            document.querySelectorAll('#dataTable tbody input[type=checkbox]').forEach(function(cb) {
                cb.checked = checked;
            });
        });

        // ===== 获取选中行的数据 =====
        function getCheckedData() {
            var result = [];
            document.querySelectorAll('#dataTable tbody input[type=checkbox]:checked').forEach(function(cb) {
                var idx = parseInt(cb.getAttribute('data-idx'));
                if (!isNaN(idx) && window._queryData && window._queryData[idx]) {
                    result.push({ index: idx, data: window._queryData[idx] });
                }
            });
            return result;
        }

        // ===== 批量登记 =====
        document.getElementById('batchRegBtn').addEventListener('click', function() {
            var checked = getCheckedData();
            if (checked.length === 0) { customDialog.info('请先勾选要登记的项目', '提示'); return; }

            // 筛选出未登记的项目
            var toReg = checked.filter(function(item) { return item.data.登记ID == null; });
            if (toReg.length === 0) { customDialog.info('勾选的项目均已登记，无需重复登记', '提示'); return; }

            customDialog.confirm('确定要批量登记选中的 ' + toReg.length + ' 个项目吗？', '确认', function() {
                var done = 0, fail = 0;
                (function process(idx) {
                    if (idx >= toReg.length) {
                        var msg = '成功 ' + done + ' 个';
                        if (fail > 0) msg += '，失败 ' + fail + ' 个';
                        customDialog.success(msg, '批量登记完成');
                        doSearch();
                        return;
                    }
                    var item = toReg[idx];
                var d = item.data;
                // 查询默认次数（按项目ID）
                var pid = (d.项目ID != null ? d.项目ID : '');
                fetch('@Url.Action("GetDefaultCountList", "MedicalTech")?项目ID=' + encodeURIComponent(pid))
                    .then(function(r) { return r.json(); })
                    .then(function(list) {
                        var qty = (d.数量 != null && d.数量 > 0) ? d.数量 : 1;
                        var 总次数 = 1 * qty;
                        if (list && list.length > 0 && list[0].默认总次数) {
                            总次数 = list[0].默认总次数 * qty;
                        }
                        return fetch('@Url.Action("Register", "MedicalTech")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                结帐ID: d.结帐ID,
                                处方ID: d.处方ID,
                                就诊ID: d.就诊ID,
                                病人姓名: d.姓名,
                                门诊号: d.门诊号,
                                项目名称: d.项目名称,
                                总次数: 总次数
                            })
                        });
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(res) {
                        if (res.success) done++; else fail++;
                        process(idx + 1);
                    })
                    .catch(function() { fail++; process(idx + 1); });
                })(0);
            });
        });

        // ===== 批量执行（逐个确认） =====
        window._batchQueue = [];
        window._batchQueueIndex = 0;

        function loadBatchItem() {
            if (window._batchQueueIndex >= window._batchQueue.length) {
                var total = window._batchQueue.length;
                closeModal('executeModal');
                window._batchQueue = [];
                customDialog.success('共完成 ' + total + ' 个项目', '批量执行完成');
                doSearch();
                return;
            }

            var d = window._batchQueue[window._batchQueueIndex].data;
            document.getElementById('exec_姓名').value = d.姓名;
            document.getElementById('exec_项目名称').value = d.项目名称;
            document.getElementById('exec_登记ID').value = d.登记ID;

            var now = new Date();
            var pad = function(n) { return n < 10 ? '0' + n : n; };
            document.getElementById('exec_执行时间').value =
                now.getFullYear() + '-' + pad(now.getMonth()+1) + '-' + pad(now.getDate()) +
                ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
            document.getElementById('exec_执行次数').value = 1;
            document.getElementById('exec_备注').value = '';

            // 更新进度显示
            document.getElementById('exec_progress').textContent =
                '（' + (window._batchQueueIndex + 1) + '/' + window._batchQueue.length + '）';
            document.getElementById('exec_skipBtn').style.display = '';

            // 加载人员下拉（只加载一次，后续复用）
            if (document.getElementById('exec_工号').options.length <= 1) {
                fetch('@Url.Action("GetStaffList", "MedicalTech")?name=')
                    .then(function(r) { return r.json(); })
                    .then(function(staffList) {
                        if (!staffList || staffList.success === false) return;
                        var jobSelect = document.getElementById('exec_工号');
                        var nameSelect = document.getElementById('exec_姓名_');
                        for (var i = 0; i < staffList.length; i++) {
                            var s = staffList[i];
                            var jobOpt = document.createElement('option');
                            jobOpt.value = s.工号; jobOpt.textContent = s.工号;
                            jobOpt.dataset.name = s.姓名; jobOpt.dataset.position = s.岗位 || '';
                            jobSelect.appendChild(jobOpt);
                            var nameOpt = document.createElement('option');
                            nameOpt.value = s.姓名; nameOpt.textContent = s.姓名;
                            nameOpt.dataset.job = s.工号; nameOpt.dataset.position = s.岗位 || '';
                            nameSelect.appendChild(nameOpt);
                        }
                    })
                    .catch(function() {});
            }

            openModal('executeModal');
        }

        function skipBatchItem() {
            window._batchQueueIndex++;
            loadBatchItem();
        }

        document.getElementById('batchExecBtn').addEventListener('click', function() {
            var checked = getCheckedData();
            if (checked.length === 0) { customDialog.info('请先勾选要执行的项目', '提示'); return; }

            // 筛选出进行中的项目（已登记且未完成）
            var toExec = checked.filter(function(item) {
                return item.data.登记ID != null && item.data.已执行次数 < item.data.总次数;
            });
            if (toExec.length === 0) { customDialog.info('勾选的项目中没有可执行的项目（已完成或未登记）', '提示'); return; }

            customDialog.confirm('将对选中的 ' + toExec.length + ' 个项目逐个执行，确定开始吗？', '确认', function() {

            window._batchQueue = toExec;
            window._batchQueueIndex = 0;
            loadBatchItem();
            });
        });

        // ===== 修改总次数 =====
        document.getElementById('updateTotalBtn').addEventListener('click', function() {
            var checked = getCheckedData();
            if (checked.length === 0) { customDialog.info('请先勾选要修改的记录', '提示'); return; }

            // 只有已登记的记录才有总次数可改
            var regs = checked.filter(function(item) { return item.data.登记ID != null; });
            if (regs.length === 0) {
                customDialog.info('勾选的项目均未登记，无法修改总次数', '提示');
                return;
            }

            var names = [];
            for (var i = 0; i < regs.length; i++) {
                names.push(regs[i].data.姓名 + ' - ' + regs[i].data.项目名称);
            }
            var skipped = checked.length - regs.length;
            var info = '已选 ' + regs.length + ' 条' +
                       (skipped > 0 ? '（另有 ' + skipped + ' 条未登记，已跳过）' : '') +
                       '：' + names.join('、');
            document.getElementById('ut_Info').value = info;
            document.getElementById('ut_新总次数').value = '';
            openModal('updateTotalModal');
        });

        function submitUpdateTotal() {
            var checked = getCheckedData();
            if (checked.length === 0) { customDialog.info('请先勾选要修改的记录', '提示'); return; }

            var newVal = parseInt(document.getElementById('ut_新总次数').value);
            if (!newVal || newVal <= 0) { customDialog.info('请输入有效的总次数', '提示'); return; }

            var ids = [];
            var regs = checked.filter(function(item) { return item.data.登记ID != null; });
            for (var i = 0; i < regs.length; i++) {
                ids.push(regs[i].data.登记ID);
            }
            if (ids.length === 0) { customDialog.info('勾选的项目均未登记，无法修改总次数', '提示'); return; }

            fetch('@Url.Action("UpdateTotalCount", "MedicalTech")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 登记IDs: ids, 新总次数: newVal })
            })
            .then(function(r) { return r.json(); })
            .then(function(res) {
                if (res.success) {
                    customDialog.alert(res.msg, '提示', function() {
                        closeModal('updateTotalModal');
                        doSearch();
                    });
                } else {
                    customDialog.error(res.msg, '修改失败');
                }
            })
            .catch(function(err) { customDialog.error(err.message, '修改失败'); });
        }

        // ===== 导出到Excel（服务端导出，含执行明细一对多；导出全部结果而非仅当前页） =====
        document.getElementById('exportBtn').addEventListener('click', function() {
            var exportBtn = this;
            var bdate = document.getElementById('bdatepicker').value;
            var edate = document.getElementById('edatepicker').value;
            var name = document.querySelector('#searchForm input[name="name"]').value;
            var 项目名称 = window._hdrFilter['项目名称'] || '';
            var 状态 = window._hdrFilter['状态'] || '';

            exportBtn.disabled = true;
            exportBtn.innerText = '导出中...';

            fetch('@Url.Action("ExportToExcel", "MedicalTech")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'bdate=' + encodeURIComponent(bdate) +
                      '&edate=' + encodeURIComponent(edate) +
                      '&name=' + encodeURIComponent(name) +
                      '&项目名称=' + encodeURIComponent(项目名称) +
                      '&状态=' + encodeURIComponent(状态)
            })
            .then(function(res) {
                // 若返回 JSON（错误提示），抛出其中的 msg
                var ct = res.headers.get('Content-Type') || '';
                if (ct.indexOf('application/json') >= 0) {
                    return res.json().then(function(e) {
                        throw new Error((e && e.msg) || '导出失败');
                    });
                }
                return res.blob();
            })
            .then(function(blob) {
                var url = window.URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = '医技登记与执行.xlsx';
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
                exportBtn.disabled = false;
                exportBtn.innerText = '导出到Excel';
            })
            .catch(function(err) {
                exportBtn.disabled = false;
                exportBtn.innerText = '导出到Excel';
                customDialog.error(err.message, '导出失败');
            });
        });

        // 回车查询
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !document.querySelector('.modal-overlay.active')) {
                doSearch();
                e.preventDefault();
            }
        });
    </script>

</body>
</html>


