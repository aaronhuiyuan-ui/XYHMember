@{
    ViewBag.Title = "套餐提成汇总";
}

@{
    var bdate = Request["bdatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
    var edate = Request["edatepicker"] ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<html>
<head>
    <meta charset="UTF-8">
    <title></title>

    @Styles.Render("~/Content/upcss")
    @Styles.Render("~/Content/my")
    @Styles.Render("~/Content/flatpickr")
    <style>
        #dataTable {
            width: 100% !important;
            min-width: 700px !important;
            table-layout: auto !important;
        }
        #dataTable th, #dataTable td { padding: 3px 10px !important; white-space: nowrap; }
        #dataTable thead th { background: #f0f0f0 !important; color: #333 !important; font-weight: 600; }
        .table-wrapper { overflow: auto !important; max-width: calc(100vw - 40px) !important; }
    </style>
</head>
<body>
    <div>
        <div class="container">
            <div>
                <form onsubmit="return false;">
                    <div class="am-input-group am-input-group-sm" style="display:inline-flex;align-items:center;margin-left:10px;">
                        <label style="margin:0 5px 0 10px;">登记时间</label>
                        <input type="text" id="bdatepicker" value="@bdate" style="height:30px;">
                        <label style="margin:0 5px;">—</label>
                        <input type="text" id="edatepicker" value="@edate" style="height:30px;">
                        <label style="margin:0 10px 0 20px;">岗位</label>
                        <select id="posFilter" style="height:30px;padding:0 6px;">
                            <option value="">全部</option>
                            <option value="医师">医师</option>
                            <option value="理疗师">理疗师</option>
                            <option value="护士">护士</option>
                        </select>
                        <span class="am-input-group-btn" style="margin-left:15px;">
                            <button class="am-btn am-btn-default" type="button" onclick="doSearch()">查询</button>
                        </span>
                    </div>
                </form>
            </div>
        </div>
        <div style="margin:10px 0 0 10px;color:#666;font-size:12px;">按「月份 + 执行人」汇总医技登记时生成的套餐提成（基数=整张收费单实际支付，医师/理疗师与护士按各自岗位比例）。</div>

        <div class="am-g">
            <div class="am-u-sm-12">
                <div class="table-wrapper" style="overflow:auto;margin:10px;">
                <table class="am-table am-table-striped am-table-hover table-main" id="dataTable" style="width:100%;">
                    <thead>
                        <tr>
                            <th>月份</th>
                            <th>工号</th>
                            <th>执行人</th>
                            <th>岗位</th>
                            <th>笔数</th>
                            <th>提成基数合计</th>
                            <th>提成金额合计</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <tr><td colspan="7" style="text-align:center;color:#999;">加载中...</td></tr>
                    </tbody>
                </table>
                </div>
                <div id="paginationContainer" style="margin-left:10px;"></div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/pagination.js"></script>
    <script src="~/Scripts/customDialog.js"></script>
    @Scripts.Render("~/Scripts/flatpickrjs")

    <script>
        flatpickr("#bdatepicker", { dateFormat: "Y-m-d", defaultDate: "@bdate" });
        flatpickr("#edatepicker", { dateFormat: "Y-m-d", defaultDate: "@edate" });

        function escapeHtml(s) {
            if (s === null || s === undefined) return '';
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function doSearch() {
            var b = document.getElementById('bdatepicker').value;
            var e = document.getElementById('edatepicker').value;
            var p = document.getElementById('posFilter').value;
            fetch('@Url.Action("GetCommissionSummary", "MedicalTech")?bdate=' + encodeURIComponent(b) +
                  '&edate=' + encodeURIComponent(e) + '&岗位=' + encodeURIComponent(p))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data && data.success === false) {
                        document.getElementById('tableBody').innerHTML =
                            '<tr><td colspan="7" style="text-align:center;color:red;">查询失败：' + escapeHtml(data.msg) + '</td></tr>';
                        return;
                    }
                    renderTable(data || []);
                })
                .catch(function(err) {
                    document.getElementById('tableBody').innerHTML =
                        '<tr><td colspan="7" style="text-align:center;color:red;">查询失败：' + escapeHtml(err.message) + '</td></tr>';
                });
        }

        function renderTable(list) {
            var tbody = document.getElementById('tableBody');
            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#999;">没有数据</td></tr>';
                return;
            }
            var html = '';
            var sum笔数 = 0, sum基数 = 0, sum金额 = 0;
            for (var i = 0; i < list.length; i++) {
                var d = list[i];
                sum笔数 += (d.笔数 || 0);
                sum基数 += (d.提成基数 || 0);
                sum金额 += (d.提成金额 || 0);
                html += '<tr>' +
                    '<td>' + escapeHtml(d.月份) + '</td>' +
                    '<td>' + escapeHtml(d.执行人工号) + '</td>' +
                    '<td>' + escapeHtml(d.执行人姓名) + '</td>' +
                    '<td>' + escapeHtml(d.岗位) + '</td>' +
                    '<td>' + (d.笔数 || 0) + '</td>' +
                    '<td>' + (d.提成基数 || 0).toFixed(2) + '</td>' +
                    '<td>' + (d.提成金额 || 0).toFixed(2) + '</td></tr>';
            }
            html += '<tr style="background:#f0f0f0;font-weight:bold;">' +
                '<td colspan="4">合计</td><td>' + sum笔数 + '</td>' +
                '<td>' + sum基数.toFixed(2) + '</td><td>' + sum金额.toFixed(2) + '</td></tr>';
            tbody.innerHTML = html;
            initTablePagination('dataTable', { summaryRows: 1 });
        }

        document.getElementById('edatepicker').addEventListener('keydown', function(e) { if (e.key === 'Enter') { doSearch(); e.preventDefault(); } });
        document.getElementById('bdatepicker').addEventListener('keydown', function(e) { if (e.key === 'Enter') { doSearch(); e.preventDefault(); } });

        doSearch();
    </script>
</body>
</html>
